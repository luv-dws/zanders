{
  "name": "zanders/zanders-theme",
  "description": "ZANDERS Shopware 6 Custom Storefront Theme",
  "version": "1.0.0",
  "type": "shopware-platform-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "ZANDERS Development Team"
    }
  ],
  "require": {
    "shopware/core": "~6.7.0",
    "shopware/storefront": "~6.7.0"
