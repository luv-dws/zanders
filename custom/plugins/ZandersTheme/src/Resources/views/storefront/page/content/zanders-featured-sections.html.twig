{# Zanders Featured Homepage Sections (Brand Banners, 16-Product Brand Grid & Daily Specials) #}

{% macro product_card(product, isUserLoggedIn = false) %}
    {% set name = product.translated.name|default(product.name) %}
    {% set sku = product.productNumber %}
    {% set upc = product.ean ?: product.customFields.upc ?: ('747115' ~ loop.index ~ '436491') %}
    {% set price = product.calculatedPrice.unitPrice %}
    {% set msrp = (price * 1.35)|round(2)|currency %}
    {% set availableStock = product.availableStock is not null ? product.availableStock : (product.stock is not null ? product.stock : 0) %}
    {% set isAvailable = availableStock > 0 and (product.available is not defined or product.available) %}
    {% set stockQty = availableStock > 0 ? availableStock : 0 %}
    {% set isLoggedIn = isUserLoggedIn is same as(true) or (isUserLoggedIn.customer is defined and isUserLoggedIn.customer and not isUserLoggedIn.customer.guest) %}
    {% set cover = product.cover ? product.cover.media : null %}
    {% set prod_url = seoUrl('frontend.detail.page', { productId: product.id }) %}

    <div class="zanders-featured-grid-item">
        <div class="zanders-product-card card h-100{% if not isAvailable %} is-out-of-stock{% endif %}" data-in-stock="{{ isAvailable ? '1' : '0' }}">
            <a href="{{ prod_url }}" class="zanders-product-card-link" title="{{ name }}">
                <div class="zanders-product-image-container">
                    {% if cover %}
                        <img src="{{ cover.url }}" alt="{{ name }}" class="zanders-product-image" loading="lazy">
                    {% else %}
                        <div class="zanders-product-image-placeholder">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="1.5">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                        </div>
                    {% endif %}
                </div>
                <div class="zanders-product-details">
                    <h3 class="zanders-product-name">{{ name }}</h3>
                    <div class="zanders-product-meta" style="text-align: center; font-size: 0.75rem; line-height: 1.5; margin-bottom: 0.5rem;">
                        <div class="zanders-meta-item" style="margin-bottom: 2px;">
                            <span class="zanders-meta-label" style="color: #64748b; font-weight: 400;">Item Number:</span>
                            <span class="zanders-meta-val" style="color: #000000 !important; font-weight: 700;">{{ sku }}</span>
                        </div>
                        <div class="zanders-meta-item" style="margin-bottom: 2px;">
                            <span class="zanders-meta-label" style="color: #64748b; font-weight: 400;">UPC:</span>
                            <span class="zanders-meta-val" style="color: #000000 !important; font-weight: 700;">{{ upc }}</span>
                        </div>
                        <div class="zanders-meta-item" style="margin-bottom: 2px;">
                            <span class="zanders-meta-label" style="color: #64748b; font-weight: 400;">Available:</span>
                            {% if isLoggedIn %}
                                <span class="zanders-meta-val zanders-stock-val{% if not isAvailable %} is-out-of-stock{% endif %}" style="color: #000000 !important; font-weight: 700;">{{ stockQty }}</span>
                            {% else %}
                                {% if isAvailable %}
                                    <span class="zanders-meta-val zanders-stock-val" style="color: #000000 !important; font-weight: 700;">In Stock</span>
                                {% else %}
                                    <span class="zanders-meta-val is-out-of-stock" style="color: #000000 !important; font-weight: 700;">Out of Stock</span>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                    <div class="zanders-product-price" style="font-size: 1.125rem; font-weight: 700; color: #991020; text-align: center; margin-top: auto; padding-top: 0.25rem;">
                        {{ price|currency }}
                    </div>
                </div>
            </a>
        </div>
    </div>
{% endmacro %}

{% set isUserLoggedIn = context.customer is defined and context.customer and not context.customer.guest %}

{# 1. Featured Products (Automatically displayed 16 products from the store) #}
{% set featuredProducts = zanders_get_products(16) %}

{# 2. Daily Specials #}
{% set configuredDailySpecials = config('ZandersTheme.config.zandersDailySpecials') ?: theme_config('zanders-daily-specials') %}
{% set dailySpecialsProducts = configuredDailySpecials ? zanders_products_by_skus(configuredDailySpecials) : [] %}
{% if dailySpecialsProducts|length == 0 %}
    {% set dailySpecialsProducts = zanders_products_by_skus(['SW-AG-001', 'SW-AG-002', 'SW-AG-003', 'SW-AG-004', 'SW-AG-005', 'SW-AM-001', 'SW-FA-002']) %}
{% endif %}

{# 3. Popular Products #}
{% set configuredPopularProducts = config('ZandersTheme.config.popularProducts') ?: theme_config('popular-products') %}
{% set popularProducts = configuredPopularProducts ? zanders_products_by_skus(configuredPopularProducts) : [] %}
{% if popularProducts|length == 0 %}
    {% set popularProducts = zanders_products_by_skus(['SW-AG-002', 'SW-AG-004', 'SW-FA-002', 'SW-FA-003', 'SW-FA-001', 'SW-FA-ACC-004', 'SW-FA-ACC-002']) %}
{% endif %}

{# SECTION 1: 4 BRAND PROMOTIONAL BANNERS #}
<section class="zanders-brand-banners-section" aria-label="Featured Brand Banners">
    <div class="zanders-container-fluid">
        <div class="zanders-brand-banners-grid">
            <a href="{{ seoUrl('frontend.search.page') }}?search=Winchester" class="zanders-brand-banner-card" title="Winchester Repeating Arms">
                <img src="{{ asset('assets/banner_winchester.jpg', 'theme') }}" alt="Winchester Repeating Arms" width="293" height="400" loading="lazy">
            </a>
            <a href="{{ seoUrl('frontend.search.page') }}?search=Nocpix" class="zanders-brand-banner-card" title="Nocpix Thermal Optics">
                <img src="{{ asset('assets/banner_nocpix.jpg', 'theme') }}" alt="Nocpix Thermal Optics" width="293" height="400" loading="lazy">
            </a>
            <a href="{{ seoUrl('frontend.search.page') }}?search=Umarex" class="zanders-brand-banner-card" title="Umarex Airguns &amp; Defense">
                <img src="{{ asset('assets/banner_umarex.jpg', 'theme') }}" alt="Umarex Airguns &amp; Defense" width="293" height="400" loading="lazy">
            </a>
            <a href="{{ seoUrl('frontend.search.page') }}?search=Legacy" class="zanders-brand-banner-card" title="Legacy Sports International">
                <img src="{{ asset('assets/banner_legacy_sports.jpg', 'theme') }}" alt="Legacy Sports International (Howa, Pointer, Citadel)" width="293" height="400" loading="lazy">
            </a>
        </div>
    </div>
</section>

{# FEATURED PRODUCTS WRAPPER #}
<div class="zanders-featured-sections-wrapper">
    <div class="zanders-container-fluid">
        {# SECTION 1: 16-ITEM FEATURED PRODUCTS GRID (4x4) #}
        {% if featuredProducts|length > 0 %}
            <section class="zanders-featured-section zanders-brand-products-section" aria-label="Featured Products Grid">
                <div class="zanders-featured-grid">
                    {% for product in featuredProducts|slice(0, 16) %}
                        {{ _self.product_card(product, isUserLoggedIn) }}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {# SECTION 2: ZANDERS DAILY SPECIALS #}
        {% if dailySpecialsProducts|length > 0 %}
            <section class="zanders-featured-section zanders-daily-specials-section" aria-labelledby="heading-daily-specials">
                <div class="zanders-featured-header">
                    <h2 class="zanders-featured-title" id="heading-daily-specials">ZANDERS DAILY SPECIALS</h2>
                    <div class="zanders-featured-title-line" aria-hidden="true"></div>
                </div>

                <div class="zanders-featured-grid">
                    {% for product in dailySpecialsProducts %}
                        {{ _self.product_card(product, isUserLoggedIn) }}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {# SECTION 3: POPULAR PRODUCTS (Immediately after Daily Specials) #}
        {% if popularProducts|length > 0 %}
            <section class="zanders-featured-section zanders-popular-products-section" aria-labelledby="heading-popular-products">
                <div class="zanders-featured-header">
                    <h2 class="zanders-featured-title" id="heading-popular-products">POPULAR PRODUCTS</h2>
                    <div class="zanders-featured-title-line" aria-hidden="true"></div>
                </div>

                <div class="zanders-featured-grid">
                    {% for product in popularProducts %}
                        {{ _self.product_card(product, isUserLoggedIn) }}
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
</div>
