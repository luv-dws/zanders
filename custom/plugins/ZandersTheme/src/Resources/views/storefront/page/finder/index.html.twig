{% sw_extends '@Storefront/storefront/base.html.twig' %}

{# Zanders Product Finder Results Page (Matches Catalog Listing Layout & Appearance) #}
{% block base_content %}

    {% set isUserLoggedIn = context.customer is defined and context.customer and not context.customer.guest %}
    {% set categoryName = 'zanders.finder.title'|trans %}
    {% set currentPage = page|default(1) %}
    {% set currentLimit = limit|default(15) %}
    {% set totalItems = total|default(products|length) %}
    {% set startItem = totalItems > 0 ? ((currentPage - 1) * currentLimit + 1) : 0 %}
    {% set endItem = (currentPage * currentLimit) < totalItems ? (currentPage * currentLimit) : totalItems %}

    <div class="zanders-category-page-wrapper">
        <div class="zanders-category-container">
            <div class="zanders-category-layout-grid">
                
                {# Product listing main section #}
                <main class="zanders-category-main-content">
                    
                    {# Breadcrumb #}
                    <nav class="zanders-category-breadcrumb" aria-label="breadcrumb">
                        <a href="{{ path('frontend.home.page') }}" class="zanders-breadcrumb-link">{{ 'zanders.listing.home'|trans }}</a>
                        <span class="zanders-breadcrumb-separator">/</span>
                        <span class="zanders-breadcrumb-current">{{ categoryName }}</span>
                    </nav>

                    {# Category Heading #}
                    <h1 class="zanders-category-heading">{{ categoryName }}</h1>

                    {# Listing Toolbar #}
                    <div class="zanders-category-toolbar">
                        <div class="zanders-toolbar-row-top">
                            <div class="zanders-toolbar-items-count">
                                {{ 'zanders.listing.items'|trans }} {{ startItem }}-{{ endItem }} {{ 'zanders.listing.of'|trans }} {{ totalItems }}
                            </div>
                            <div class="zanders-toolbar-pagination">
                                <span class="zanders-page-label">{{ 'zanders.listing.page'|trans }}</span>
                                {% if currentPage > 1 %}
                                    <a href="{{ path('frontend.zanders.finder', activeFilters|default({})|merge({ p: currentPage - 1 })) }}" class="zanders-page-arrow">&lt;</a>
                                {% else %}
                                    <span class="zanders-page-arrow is-disabled">&lt;</span>
                                {% endif %}

                                <span class="zanders-page-num is-active">{{ currentPage }}</span>

                                {% if pages|default(1) > currentPage %}
                                    <a href="{{ path('frontend.zanders.finder', activeFilters|default({})|merge({ p: currentPage + 1 })) }}" class="zanders-page-arrow">&gt;</a>
                                {% else %}
                                    <span class="zanders-page-arrow is-disabled">&gt;</span>
                                {% endif %}
                            </div>
                            <div class="zanders-toolbar-per-page">
                                <label for="zandersShowPerPage" class="zanders-per-page-label">{{ 'zanders.listing.show'|trans }}</label>
                                <select id="zandersShowPerPage" class="zanders-per-page-select" onchange="var p=new URLSearchParams(window.location.search);p.set('limit',this.value);p.set('p',1);window.location.search=p.toString();">
                                    <option value="15"{% if currentLimit == 15 %} selected{% endif %}>15 {{ 'zanders.listing.perPage'|trans }}</option>
                                    <option value="30"{% if currentLimit == 30 %} selected{% endif %}>30 {{ 'zanders.listing.perPage'|trans }}</option>
                                    <option value="60"{% if currentLimit == 60 %} selected{% endif %}>60 {{ 'zanders.listing.perPage'|trans }}</option>
                                </select>
                            </div>
                        </div>

                        <div class="zanders-toolbar-divider"></div>

                        <div class="zanders-toolbar-row-bottom">
                            <div class="zanders-toolbar-views">
                                <span class="zanders-view-as-label">{{ 'zanders.listing.viewAs'|trans }}</span>
                                <button type="button" class="zanders-view-btn is-active" title="{{ 'zanders.listing.gridView'|trans|striptags }}" aria-label="{{ 'zanders.listing.gridView'|trans|striptags }}">
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                        <rect x="0" y="0" width="4" height="4"></rect>
                                        <rect x="6" y="0" width="4" height="4"></rect>
                                        <rect x="12" y="0" width="4" height="4"></rect>
                                        <rect x="0" y="6" width="4" height="4"></rect>
                                        <rect x="6" y="6" width="4" height="4"></rect>
                                        <rect x="12" y="6" width="4" height="4"></rect>
                                        <rect x="0" y="12" width="4" height="4"></rect>
                                        <rect x="6" y="12" width="4" height="4"></rect>
                                        <rect x="12" y="12" width="4" height="4"></rect>
                                    </svg>
                                </button>
                                <button type="button" class="zanders-view-btn" title="{{ 'zanders.listing.listView'|trans|striptags }}" aria-label="{{ 'zanders.listing.listView'|trans|striptags }}">
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                        <rect x="0" y="1" width="16" height="3"></rect>
                                        <rect x="0" y="6" width="16" height="3"></rect>
                                        <rect x="0" y="11" width="16" height="3"></rect>
                                    </svg>
                                </button>
                                <button type="button" class="zanders-view-btn" title="{{ 'zanders.listing.detailView'|trans|striptags }}" aria-label="{{ 'zanders.listing.detailView'|trans|striptags }}">
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                        <rect x="0" y="1" width="4" height="4"></rect>
                                        <rect x="6" y="2" width="10" height="2"></rect>
                                        <rect x="0" y="7" width="4" height="4"></rect>
                                        <rect x="6" y="8" width="10" height="2"></rect>
                                    </svg>
                                </button>
                            </div>

                            <div class="zanders-toolbar-stock-toggle">
                                {% set isHidingStock = activeFilters.inStock|default(false) %}
                                <a href="{{ path('frontend.zanders.finder', activeFilters|default({})|merge({ inStock: isHidingStock ? '0' : '1' })) }}" class="zanders-stock-link">
                                    {{ isHidingStock ? ('zanders.listing.showAll'|trans) : ('zanders.listing.hideOutOfStock'|trans) }}
                                </a>
                            </div>

                            <div class="zanders-toolbar-sorting">
                                <label for="zandersSortBy" class="zanders-sort-label">{{ 'zanders.listing.sortBy'|trans }}</label>
                                <select id="zandersSortBy" class="zanders-sort-select" onchange="var p=new URLSearchParams(window.location.search);p.set('order',this.value);window.location.search=p.toString();">
                                    <option value="price-asc"{% if activeFilters.order|default('') == 'price-asc' %} selected{% endif %}>{{ 'zanders.listing.price'|trans }}</option>
                                    <option value="name-asc"{% if activeFilters.order|default('') == 'name-asc' or not activeFilters.order %} selected{% endif %}>{{ 'zanders.listing.nameAZ'|trans }}</option>
                                    <option value="name-desc"{% if activeFilters.order|default('') == 'name-desc' %} selected{% endif %}>{{ 'zanders.listing.nameZA'|trans }}</option>
                                    <option value="price-desc"{% if activeFilters.order|default('') == 'price-desc' %} selected{% endif %}>{{ 'zanders.listing.priceHighLow'|trans }}</option>
                                    <option value="topseller"{% if activeFilters.order|default('') == 'topseller' %} selected{% endif %}>{{ 'zanders.listing.topseller'|trans }}</option>
                                </select>
                                <span class="zanders-sort-direction" title="{{ 'zanders.listing.ascending'|trans|striptags }}">↑</span>
                            </div>
                        </div>
                    </div>

                    {# 3-Column Product Grid #}
                    <div class="zanders-category-product-grid">
                        {% for product in products %}
                            {% sw_include '@Storefront/storefront/component/product/card/zanders-card.html.twig' with {
                                product: product,
                                context: context,
                                isUserLoggedIn: isUserLoggedIn
                            } %}
                        {% else %}
                            <div class="zanders-category-empty-alert alert alert-info w-100">
                                {{ 'zanders.listing.noProductsFound'|trans }}
                            </div>
                        {% endfor %}
                    </div>
                </main>

            </div>
        </div>
    </div>
{% endblock %}
