{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_head %}
    {% sw_include '@Storefront/storefront/layout/meta.html.twig' %}
    {% block page_account_order_history_print_title %}
        <title>{% block page_account_order_history_print_title_text %}{{ 'account.orderNumber'|trans }}{{ order.orderNumber }}{% endblock %}</title>
    {% endblock %}
    {% block page_account_order_history_print_stylesheets %}
        {% for file in theme_config('assets.css') %}
            <link rel="stylesheet" href="{{ asset(file, 'theme') }}">
        {% endfor %}
    {% endblock %}
{% endblock %}

{% block base_body_skip_to_content %}{% endblock %}

{% block base_header %}{% endblock %}

{% block base_navigation %}{% endblock %}

{% block base_footer %}{% endblock %}

{% block base_cookie_permission %}{% endblock %}

{% block base_body_classes %}zanders-order-print-body{% endblock %}

{% block base_main %}
    {% block page_account_order_history_print_container %}
        <div class="zanders-print-container" data-order-print-page="true">
            {% block page_account_order_history_print_logo %}
                <div class="zanders-logo-section">
                    <img src="{{ asset('assets/zanders-logo.png', 'theme') }}"
                         alt="{{ 'header.logo'|trans|default('ZANDERS') }}"
                         class="zanders-logo-img">
                </div>
            {% endblock %}

            {% block page_account_order_history_print_date %}
                <div class="zanders-order-date">
                    {{ 'zanders.orderPrint.orderDate'|trans }}: {{ order.orderDateTime|format_date('long') }}
                </div>
            {% endblock %}

            {% block page_account_order_history_print_info_card %}
                <div class="zanders-info-card">
                    {% block page_account_order_history_print_shipping_row %}
                        <div class="zanders-info-row">
                            {% block page_account_order_history_print_shipping_address %}
                                <div class="zanders-info-col">
                                    <div class="zanders-info-title">{{ 'zanders.orderPrint.shippingAddress'|trans }}</div>
                                    <div class="zanders-info-content">
                                        {% set delivery = order.deliveries|first %}
                                        {% set shipping = delivery ? delivery.shippingOrderAddress : order.billingAddress %}
                                        {% if shipping %}
                                            {% if shipping.company %}
                                                <div class="zanders-addr-line">{{ shipping.company|upper }}</div>
                                            {% else %}
                                                <div class="zanders-addr-line">{{ (shipping.firstName ~ ' ' ~ shipping.lastName)|upper }}</div>
                                            {% endif %}
                                            <div class="zanders-addr-line">{{ shipping.street|upper }}</div>
                                            <div class="zanders-addr-line">
                                                {{ shipping.city|upper }} , {{ shipping.countryState ? ((shipping.countryState.shortCode|replace({'US-': ''})) ?: shipping.countryState.translated.name) : '' }} {{ shipping.zipcode }}
                                            </div>
                                        {% else %}
                                            <div>{{ 'zanders.orderPrint.notAvailable'|trans }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endblock %}

                            {% block page_account_order_history_print_shipping_method %}
                                <div class="zanders-info-col">
                                    <div class="zanders-info-title">{{ 'zanders.orderPrint.shippingMethod'|trans }}</div>
                                    <div class="zanders-info-content">
                                        <div>{{ delivery and delivery.shippingMethod ? delivery.shippingMethod.translated.name : ('zanders.orderPrint.defaultShippingMethod'|trans) }}</div>
                                        {% if order.customerComment %}
                                            <div class="zanders-meta-line">
                                                <strong>{{ 'zanders.orderPrint.instructions'|trans }}:</strong> {{ order.customerComment|upper }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endblock %}
                        </div>
                    {% endblock %}

                    <div class="zanders-info-divider"></div>

                    {% block page_account_order_history_print_billing_row %}
                        <div class="zanders-info-row">
                            {% block page_account_order_history_print_billing_address %}
                                <div class="zanders-info-col">
                                    <div class="zanders-info-title">{{ 'zanders.orderPrint.billingAddress'|trans }}</div>
                                    <div class="zanders-info-content">
                                        {% set billing = order.billingAddress %}
                                        {% if billing %}
                                            {% if billing.company %}
                                                <div class="zanders-addr-line">{{ billing.company|upper }}</div>
                                            {% else %}
                                                <div class="zanders-addr-line">{{ (billing.firstName ~ ' ' ~ billing.lastName)|upper }}</div>
                                            {% endif %}
                                            <div class="zanders-addr-line">{{ billing.street|upper }}</div>
                                            <div class="zanders-addr-line">
                                                {{ billing.city|upper }} , {{ billing.countryState ? ((billing.countryState.shortCode|replace({'US-': ''})) ?: billing.countryState.translated.name) : '' }} {{ billing.zipcode }}
                                            </div>
                                        {% else %}
                                            <div>{{ 'zanders.orderPrint.notAvailable'|trans }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endblock %}

                            {% block page_account_order_history_print_payment_method %}
                                <div class="zanders-info-col">
                                    <div class="zanders-info-title">{{ 'zanders.orderPrint.paymentMethod'|trans }}</div>
                                    <div class="zanders-info-content">
                                        {% set transaction = order.transactions|last %}
                                        <div>{{ transaction and transaction.paymentMethod ? transaction.paymentMethod.translated.name : ('zanders.orderPrint.defaultPaymentMethod'|trans) }}</div>
                                        <div class="zanders-meta-line">
                                            <strong>{{ 'zanders.orderPrint.purchaseOrderNumber'|trans }}:</strong> {{ order.customFields.purchaseOrderNumber|default(order.orderNumber) }}
                                        </div>
                                        <div class="zanders-meta-line">
                                            <strong>{{ 'zanders.orderPrint.shipPickUpDate'|trans }}:</strong> {{ order.orderDateTime|format_date('short') }}
                                        </div>
                                    </div>
                                </div>
                            {% endblock %}
                        </div>
                    {% endblock %}
                </div>
            {% endblock %}

            {% block page_account_order_history_print_items %}
                <h2 class="zanders-items-heading">{{ 'zanders.orderPrint.itemsOrdered'|trans }}</h2>

                <table class="zanders-table">
                    <thead>
                        {% block page_account_order_history_print_table_head %}
                            <tr>
                                <th class="col-product">{{ 'zanders.orderPrint.productName'|trans }}</th>
                                <th class="col-item-no">{{ 'zanders.orderPrint.itemNumber'|trans }}</th>
                                <th class="col-price">{{ 'zanders.orderPrint.price'|trans }}</th>
                                <th class="col-qty">{{ 'zanders.orderPrint.qty'|trans }}</th>
                                <th class="col-subtotal th-subtotal">{{ 'zanders.orderPrint.subtotal'|trans }}</th>
                            </tr>
                        {% endblock %}
                    </thead>
                    <tbody>
                        {% block page_account_order_history_print_table_body %}
                            {% for lineItem in order.lineItems %}
                                {% block page_account_order_history_print_table_row %}
                                    <tr class="{{ cycle(['row-even', 'row-odd'], loop.index0) }}">
                                        <td class="col-product">
                                            {{ lineItem.label|upper }}
                                        </td>
                                        <td class="col-item-no">
                                            {{ (lineItem.payload.productNumber ?: (lineItem.payload.sku ?: lineItem.identifier))|upper }}
                                        </td>
                                        <td class="col-price">
                                            {{ lineItem.unitPrice|currency(order.currency.isoCode) }}
                                        </td>
                                        <td class="col-qty">
                                            <div class="qty-line">{{ 'zanders.orderPrint.ordered'|trans }} : <strong>{{ lineItem.quantity }}</strong></div>
                                            {% if lineItem.payload.isBackorder or lineItem.payload.backordered %}
                                                <div class="qty-line">{{ 'zanders.orderPrint.backOrdered'|trans }} : <strong>{{ lineItem.quantity }}</strong></div>
                                            {% else %}
                                                <div class="qty-line">{{ 'zanders.orderPrint.toShip'|trans }} : <strong>{{ lineItem.quantity }}</strong></div>
                                            {% endif %}
                                        </td>
                                        <td class="col-subtotal">
                                            {{ lineItem.totalPrice|currency(order.currency.isoCode) }}
                                        </td>
                                    </tr>
                                {% endblock %}
                            {% endfor %}
                        {% endblock %}
                    </tbody>
                </table>
            {% endblock %}

            {% block page_account_order_history_print_totals %}
                <table class="zanders-totals-table">
                    <tbody>
                        {% block page_account_order_history_print_totals_sales_amount %}
                            <tr class="totals-row">
                                <td class="totals-label">{{ 'zanders.orderPrint.salesAmount'|trans }}</td>
                                <td class="totals-value">{{ order.positionPrice|currency(order.currency.isoCode) }}</td>
                            </tr>
                        {% endblock %}

                        {% block page_account_order_history_print_totals_shipping %}
                            <tr class="totals-row">
                                <td class="totals-label">{{ 'zanders.orderPrint.shipping'|trans }}</td>
                                <td class="totals-value">{{ (order.shippingTotal ?: 0)|currency(order.currency.isoCode) }}</td>
                            </tr>
                        {% endblock %}

                        {% block page_account_order_history_print_totals_misc %}
                            <tr class="totals-row">
                                <td class="totals-label">{{ 'zanders.orderPrint.miscCharges'|trans }}</td>
                                <td class="totals-value">
                                    {% set misc = (order.amountTotal - order.positionPrice - order.shippingTotal - order.amountTax) %}
                                    {% if misc < 0 %}{% set misc = 0 %}{% endif %}
                                    {{ misc|currency(order.currency.isoCode) }}
                                </td>
                            </tr>
                        {% endblock %}

                        {% block page_account_order_history_print_totals_tax %}
                            <tr class="totals-row">
                                <td class="totals-label">{{ 'zanders.orderPrint.salesTax'|trans }}</td>
                                <td class="totals-value">{{ (order.amountTax ?: 0)|currency(order.currency.isoCode) }}</td>
                            </tr>
                        {% endblock %}

                        {% block page_account_order_history_print_totals_grand_total %}
                            <tr class="grand-total-row">
                                <td class="grand-total-label">{{ 'zanders.orderPrint.grandTotal'|trans }}</td>
                                <td class="grand-total-value">{{ order.amountTotal|currency(order.currency.isoCode) }}</td>
                            </tr>
                        {% endblock %}
                    </tbody>
                </table>
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}
