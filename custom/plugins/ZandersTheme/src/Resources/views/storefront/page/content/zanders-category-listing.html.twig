{# Zanders Category Listing Page #}
{% block page_content_zanders_category_listing %}
    {% set slot = page.cmsPage ? page.cmsPage.getFirstElementOfType('product-listing') : null %}
    {% set listing = listingOverride is defined ? listingOverride : (slot ? slot.data.listing : null) %}
    {% set products = listing ? listing.entities : [] %}
    {% set categoryName = categoryNameOverride is defined ? categoryNameOverride : page.category.translated.name|default('Category') %}
    {% set breadcrumbLabel = breadcrumbLabelOverride is defined ? breadcrumbLabelOverride : categoryName %}
    {% set isUserLoggedIn = context.customer is defined and context.customer and not context.customer.guest %}
    {% set isSearchResults = isSearchResults|default(false) %}
    {% set startItem = isSearchResults and listing and listing.total > 0 ? ((listing.page - 1) * listing.limit + 1) : (products|length > 0 ? 1 : 0) %}
    {% set endItem = isSearchResults and listing and listing.total > 0 ? (startItem + products|length - 1) : products|length %}

    <div class="zanders-category-page-wrapper">
        <div class="zanders-category-container">
            <div class="zanders-category-layout-grid">
                {# Product listing section kept in its current position & width #}
                <main class="zanders-category-main-content">
                    {% block page_content_zanders_category_listing_breadcrumb %}
                        {# Breadcrumb #}
                        <nav class="zanders-category-breadcrumb" aria-label="breadcrumb">
                            <a href="{{ path('frontend.home.page') }}" class="zanders-breadcrumb-link">{{ 'zanders.listing.home'|trans }}</a>
                            <span class="zanders-breadcrumb-separator">/</span>
                            <span class="zanders-breadcrumb-current">{{ breadcrumbLabel }}</span>
                        </nav>
                    {% endblock %}

                    {% block page_content_zanders_category_listing_heading %}
                        {# Category Heading #}
                        <h1 class="zanders-category-heading">{{ categoryName }}</h1>
                    {% endblock %}

                    {% block page_content_zanders_category_listing_toolbar %}
                        {# Listing Toolbar #}
                        <div class="zanders-category-toolbar">
                            {% block page_content_zanders_category_listing_toolbar_top %}
                                <div class="zanders-toolbar-row-top">
                                    {% block page_content_zanders_category_listing_toolbar_items_count %}
                                        <div class="zanders-toolbar-items-count">
                                            {{ 'zanders.listing.items'|trans }} {{ startItem }}-{{ endItem }} {{ 'zanders.listing.of'|trans }} {{ listing ? listing.total : products|length }}
                                        </div>
                                    {% endblock %}

                                    {% block page_content_zanders_category_listing_toolbar_pagination %}
                                        <div class="zanders-toolbar-pagination">
                                            <span class="zanders-page-label">{{ 'zanders.listing.page'|trans }}</span>
                                            {% if isSearchResults and listing %}
                                                {% if listing.page > 1 %}
                                                    <a href="{{ path('frontend.search.page', { search: page.searchTerm, p: listing.page - 1, order: listing.sorting, limit: listing.limit }) }}" class="zanders-page-arrow" aria-label="{{ 'zanders.listing.previousPage'|trans|striptags }}">&lt;</a>
                                                {% else %}
                                                    <span class="zanders-page-arrow">&lt;</span>
                                                {% endif %}
                                                <span class="zanders-page-num is-active">{{ listing.page }}</span>
                                                {% if listing.page * listing.limit < listing.total %}
                                                    <a href="{{ path('frontend.search.page', { search: page.searchTerm, p: listing.page + 1, order: listing.sorting, limit: listing.limit }) }}" class="zanders-page-arrow" aria-label="{{ 'zanders.listing.nextPage'|trans|striptags }}">&gt;</a>
                                                {% else %}
                                                    <span class="zanders-page-arrow">&gt;</span>
                                                {% endif %}
                                            {% else %}
                                                <span class="zanders-page-arrow">&lt;</span>
                                                <span class="zanders-page-num is-active">1</span>
                                                <span class="zanders-page-arrow">&gt;</span>
                                            {% endif %}
                                        </div>
                                    {% endblock %}

                                    {% block page_content_zanders_category_listing_toolbar_per_page %}
                                        <div class="zanders-toolbar-per-page">
                                            <label for="zandersShowPerPage" class="zanders-per-page-label">{{ 'zanders.listing.show'|trans }}</label>
                                            <select id="zandersShowPerPage" class="zanders-per-page-select"{% if isSearchResults %} onchange="var params = new URLSearchParams(window.location.search); params.set('limit', this.value); params.set('p', '1'); window.location.search = params.toString();"{% endif %}>
                                                <option value="15"{% if not isSearchResults or listing.limit == 15 %} selected{% endif %}>15 {{ 'zanders.listing.perPage'|trans }}</option>
                                                <option value="30"{% if isSearchResults and listing.limit == 30 %} selected{% endif %}>30 {{ 'zanders.listing.perPage'|trans }}</option>
                                                <option value="60"{% if isSearchResults and listing.limit == 60 %} selected{% endif %}>60 {{ 'zanders.listing.perPage'|trans }}</option>
                                            </select>
                                        </div>
                                    {% endblock %}
                                </div>
                            {% endblock %}

                            <div class="zanders-toolbar-divider"></div>

                            {% block page_content_zanders_category_listing_toolbar_bottom %}
                                <div class="zanders-toolbar-row-bottom">
                                    {% block page_content_zanders_category_listing_toolbar_views %}
                                        <div class="zanders-toolbar-views">
                                            <span class="zanders-view-as-label">{{ 'zanders.listing.viewAs'|trans }}</span>
                                            <button type="button" class="zanders-view-btn is-active" title="{{ 'zanders.listing.gridView'|trans|striptags }}" aria-label="{{ 'zanders.listing.gridView'|trans|striptags }}">
                                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                                    <rect x="0" y="0" width="4" height="4"></rect>
                                                    <rect x="6" y="0" width="4" height="4"></rect>
                                                    <rect x="12" y="0" width="4" height="4"></rect>
                                                    <rect x="0" y="6" width="4" height="4"></rect>
                                                    <rect x="6" y="6" width="4" height="4"></rect>
                                                    <rect x="12" y="6" width="4" height="4"></rect>
                                                    <rect x="0" y="12" width="4" height="4"></rect>
                                                    <rect x="6" y="12" width="4" height="4"></rect>
                                                    <rect x="12" y="12" width="4" height="4"></rect>
                                                </svg>
                                            </button>
                                            <button type="button" class="zanders-view-btn" title="{{ 'zanders.listing.listView'|trans|striptags }}" aria-label="{{ 'zanders.listing.listView'|trans|striptags }}">
                                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                                    <rect x="0" y="1" width="16" height="3"></rect>
                                                    <rect x="0" y="6" width="16" height="3"></rect>
                                                    <rect x="0" y="11" width="16" height="3"></rect>
                                                </svg>
                                            </button>
                                            <button type="button" class="zanders-view-btn" title="{{ 'zanders.listing.detailView'|trans|striptags }}" aria-label="{{ 'zanders.listing.detailView'|trans|striptags }}">
                                                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                                                    <rect x="0" y="1" width="4" height="4"></rect>
                                                    <rect x="6" y="2" width="10" height="2"></rect>
                                                    <rect x="0" y="7" width="4" height="4"></rect>
                                                    <rect x="6" y="8" width="10" height="2"></rect>
                                                </svg>
                                            </button>
                                        </div>
                                    {% endblock %}

                                    {% block page_content_zanders_category_listing_toolbar_stock_toggle %}
                                        <div class="zanders-toolbar-stock-toggle">
                                            <a href="#" class="zanders-stock-link" onclick="return false;">{{ 'zanders.listing.hideOutOfStock'|trans }}</a>
                                        </div>
                                    {% endblock %}

                                    {% block page_content_zanders_category_listing_toolbar_sorting %}
                                        <div class="zanders-toolbar-sorting">
                                            <label for="zandersSortBy" class="zanders-sort-label">{{ 'zanders.listing.sortBy'|trans }}</label>
                                            <select id="zandersSortBy" class="zanders-sort-select"{% if isSearchResults %} onchange="var params = new URLSearchParams(window.location.search); params.set('order', this.value); params.set('p', '1'); window.location.search = params.toString();"{% else %} onchange="if(this.value){window.location.search = '?order=' + this.value;}"{% endif %}>
                                                <option value="price-asc"{% if listing and listing.sorting == 'price-asc' %} selected{% endif %}>{{ 'zanders.listing.price'|trans }}</option>
                                                <option value="name-asc"{% if listing and listing.sorting == 'name-asc' %} selected{% endif %}>{{ 'zanders.listing.nameAZ'|trans }}</option>
                                                <option value="name-desc"{% if listing and listing.sorting == 'name-desc' %} selected{% endif %}>{{ 'zanders.listing.nameZA'|trans }}</option>
                                                <option value="price-desc"{% if listing and listing.sorting == 'price-desc' %} selected{% endif %}>{{ 'zanders.listing.priceHighLow'|trans }}</option>
                                                <option value="topseller"{% if listing and listing.sorting == 'topseller' %} selected{% endif %}>{{ 'zanders.listing.topseller'|trans }}</option>
                                            </select>
                                            <span class="zanders-sort-direction" title="{{ 'zanders.listing.ascending'|trans|striptags }}">↑</span>
                                        </div>
                                    {% endblock %}
                                </div>
                            {% endblock %}
                        </div>
                    {% endblock %}

                    {% block page_content_zanders_category_listing_grid %}
                        {# 3-Column Product Grid #}
                        <div class="zanders-category-product-grid">
                            {% for product in products %}
                                {% block page_content_zanders_category_listing_grid_item %}
                                    {% sw_include '@Storefront/storefront/component/product/card/zanders-card.html.twig' with {
                                        product: product,
                                        context: context,
                                        isUserLoggedIn: isUserLoggedIn
                                    } %}
                                {% endblock %}
                            {% else %}
                                {% block page_content_zanders_category_listing_empty %}
                                    <div class="zanders-category-empty-alert alert alert-info w-100">
                                        {% if isSearchResults|default(false) %}
                                            {{ 'listing.emptyResultMessage'|trans|sw_sanitize }}
                                        {% else %}
                                            {{ 'zanders.listing.noProductsCategory'|trans }}
                                        {% endif %}
                                    </div>
                                {% endblock %}
                            {% endfor %}
                        </div>
                    {% endblock %}
                </main>
            </div>
        </div>
    </div>
{% endblock %}
