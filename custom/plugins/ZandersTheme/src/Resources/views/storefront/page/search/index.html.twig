{% sw_extends '@Storefront/storefront/page/search/index.html.twig' %}

{% block page_search %}
    {% set searchHeading = page.searchTerm
        ? 'search.headline'|trans({
            '%count%': page.listing.total,
            '%searchTerm%': page.searchTerm,
        })
        : 'zanders.search.searchLabel'|trans %}

    {% sw_include '@Storefront/storefront/page/content/zanders-category-listing.html.twig' with {
        listingOverride: page.listing,
        categoryNameOverride: searchHeading,
        breadcrumbLabelOverride: page.searchTerm|default('zanders.search.searchLabel'|trans),
        isSearchResults: true,
    } %}
{% endblock %}
