{% sw_extends '@Storefront/storefront/page/content/product-detail.html.twig' %}

{% block base_body_classes %}
    {{ parent() }} is-active-route-frontend-detail-page zanders-has-open-catalog
{% endblock %}

{# Replace entire main content with custom product detail layout #}
{% block base_main_inner %}
    {% set isUserLoggedIn = context.customer is defined and context.customer and not context.customer.guest %}
    {% set product = page.product %}
    {% set quantityAdjustment = zanders_quantity_adjustment(product) %}
    {% set quantityFrom = quantityAdjustment.from|default(product.minPurchase|default(1)) %}
    {% set quantityTo = quantityAdjustment.to|default(product.calculatedMaxPurchase|default(100)) %}
    {% set quantityStep = quantityAdjustment.step|default(product.purchaseSteps|default(1)) %}
    {% set mainImage = product.cover.media ?? null %}
    {% set allMedia = product.media ?? null %}
    {% set availableStock = product.availableStock is not null ? product.availableStock : (product.stock is not null ? product.stock : 0) %}
    {% set isAvailable = availableStock > 0 and (product.available is not defined or product.available) %}
    {% set detailPrice = product.calculatedPrice %}
    {% if product.calculatedPrices|length == 1 %}
        {% set detailPrice = product.calculatedPrices.first %}
    {% endif %}
    {% set formattedPrice = isUserLoggedIn ? detailPrice.unitPrice|currency : ('zanders.product.loginToViewPrice'|trans) %}

    <div class="zanders-product-detail-wrapper">
        <div class="zanders-container-fluid">

            <div class="zanders-pd-top-section">

                <div class="zanders-pd-sidebar-space" aria-hidden="true"></div>

                <div class="zanders-pd-main-content">
                    <nav class="zanders-pd-breadcrumb" aria-label="breadcrumb">
                        <a href="{{ path('frontend.home.page') }}" class="zanders-pd-breadcrumb-link">{{ 'zanders.detail.home'|trans }}</a>
                        <span class="zanders-pd-breadcrumb-sep">/</span>
                        {% if product.seoCategory %}
                            <a href="{{ category_url(product.seoCategory) }}" class="zanders-pd-breadcrumb-link">{{ product.seoCategory.translated.name }}</a>
                            <span class="zanders-pd-breadcrumb-sep">/</span>
                        {% endif %}
                        <span class="zanders-pd-breadcrumb-current">{{ product.translated.name }}</span>
                    </nav>

                    <div class="zanders-pd-product-grid">

                        <div class="zanders-pd-gallery-col">

                            {% if isUserLoggedIn %}
                                <div class="zanders-pd-actions-row">
                                    <button
                                        type="button"
                                        class="zanders-pd-action-link zanders-compare-action-btn"
                                        data-compare-btn
                                        data-product-id="{{ product.id }}"
                                        data-product-name="{{ product.translated.name|e('html_attr') }}"
                                        data-product-sku="{{ product.productNumber|e('html_attr') }}"
                                        data-product-upc="{{ (product.ean ?: '')|e('html_attr') }}"
                                        data-product-brand="{{ (product.manufacturer ? product.manufacturer.translated.name : '')|e('html_attr') }}"
                                        data-product-price="{{ formattedPrice|e('html_attr') }}"
                                        data-product-image="{{ mainImage ? mainImage.url : '' }}"
                                        data-product-url="{{ seoUrl('frontend.detail.page', {productId: product.id}) }}"
                                        data-product-stock="{{ availableStock >= 50 ? ('50+ ' ~ ('zanders.product.inStock'|trans)) : (availableStock > 0 ? ('zanders.delivery.inStockCount'|trans({'%count%' : availableStock})) : ('zanders.product.outOfStock'|trans)) }}"
                                        data-product-in-stock="{{ isAvailable ? '1' : '0' }}"
                                        title="{{ 'zanders.product.addToCompare'|trans|striptags }}"
                                        aria-label="{{ 'zanders.product.addToCompare'|trans|striptags }}"
                                    >
                                        <svg class="zanders-action-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                                            <path d="M9 9h6M9 12h6M9 15h4"/>
                                        </svg>
                                        <span class="zanders-compare-btn-text">{{ 'zanders.product.addToCompare'|trans|striptags }}</span>
                                    </button>
                                </div>
                            {% endif %}

                            {% set mainImage = product.cover.media ?? null %}
                            {% set allMedia = product.media ?? null %}

                            <div class="zanders-pd-main-image-box">
                                {% if mainImage %}
                                    <img
                                        src="{{ mainImage.url }}"
                                        alt="{{ product.translated.name }}"
                                        class="zanders-pd-main-img"
                                        id="zanders-main-product-image"
                                    >
                                {% else %}
                                    <div class="zanders-pd-no-image">
                                        <span>{{ 'zanders.detail.noImageAvailable'|trans }}</span>
                                    </div>
                                {% endif %}
                            </div>

                            {% if allMedia and allMedia|length > 1 %}
                                <div class="zanders-pd-thumbnails-row">
                                    {% for mediaItem in allMedia %}
                                        {% if mediaItem.media %}
                                            <div
                                                class="zanders-pd-thumb-box{% if loop.first %} is-active{% endif %}"
                                                onclick="
                                                     document.getElementById('zanders-main-product-image').src='{{ mediaItem.media.url }}';
                                                     document.querySelectorAll('.zanders-pd-thumb-box').forEach(function(el){el.classList.remove('is-active');});
                                                     this.classList.add('is-active');
                                                 "
                                            >
                                                <img
                                                    src="{{ mediaItem.media.url }}"
                                                    alt="{{ mediaItem.media.translated.alt ?? product.translated.name }}"
                                                    class="zanders-pd-thumb-img"
                                                >
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="zanders-pd-buybox-col">

                            <h1 class="zanders-pd-title">{{ product.translated.name }}</h1>

                            {% if product.productNumber %}
                                <div class="zanders-pd-meta-row zanders-pd-item-row">
                                    <span class="zanders-pd-label">{{ 'zanders.detail.itemNumberLabel'|trans }}</span>
                                    <span class="zanders-pd-val">{{ product.productNumber }}</span>
                                </div>
                            {% endif %}

                            {% set availableStock = product.availableStock is not null ? product.availableStock : (product.stock is not null ? product.stock : 0) %}
                            <div class="zanders-pd-meta-row zanders-pd-stock-row">
                                <span class="zanders-pd-label">{{ 'zanders.detail.availableLabel'|trans }}</span>
                                <span class="zanders-pd-val zanders-pd-stock-val">
                                    {% if availableStock >= 50 %}
                                        50+
                                    {% elseif availableStock > 0 %}
                                        {{ availableStock }}
                                    {% else %}
                                        {{ 'zanders.product.outOfStock'|trans }}
                                    {% endif %}
                                </span>
                            </div>

                            {% set price = product.calculatedPrice %}
                            {% if product.calculatedPrices|length == 1 %}
                                {% set price = product.calculatedPrices.first %}
                            {% endif %}
                            {% set unitPrice = price.unitPrice|currency %}
                            {% set hasMsrp = price.listPrice and price.listPrice.price > price.unitPrice %}

                            {% if isUserLoggedIn %}
                                <div class="zanders-pd-price-row">
                                    <span class="zanders-pd-current-price">{{ unitPrice }}</span>
                                    {% if hasMsrp %}
                                        <span class="zanders-pd-msrp">{{ 'zanders.detail.msrp'|trans }} <span class="zanders-pd-msrp-val">{{ price.listPrice.price|currency }}</span></span>
                                    {% endif %}
                                </div>

                                {# Buy Form: Qty + Add to Cart #}
                                {% set isRestricted = zanders_is_product_restricted(product) %}
                                {% set canPurchase = zanders_can_customer_purchase() %}
                                {% if isRestricted or not canPurchase %}
                                    <div class="zanders-pd-restriction-notice alert alert-warning" role="alert">
                                        {% if not canPurchase %}
                                            {{ zanders_purchase_restriction_reason()|sw_sanitize }}
                                        {% else %}
                                            {{ 'zanders.restriction.notAvailable'|trans|default('This product is not available in your shipping region.') }}
                                        {% endif %}
                                    </div>
                                {% elseif product.active %}
                                    {% set isNotifyMeEnabled = config('ZandersTheme.config.enableNotifyMe') %}
                                    {% if isNotifyMeEnabled is null %}
                                        {% set isNotifyMeEnabled = true %}
                                    {% endif %}

                                    {% if isNotifyMeEnabled and availableStock <= 0 %}
                                        <div class="zanders-stock-notification-wrapper mb-3">
                                            <form
                                                action="{{ path('frontend.stock_notification.subscribe') }}"
                                                method="post"
                                                class="zanders-stock-notification-form"
                                                data-stock-notification="true"
                                            >

                                                <input type="hidden" name="productId" value="{{ product.id }}">

                                                <div class="alert alert-warning mb-2 py-2 px-3 small" role="alert">
                                                    {{ 'zanders.stockNotification.outOfStockNotice'|trans }}
                                                </div>

                                                <div class="input-group">
                                                    <input
                                                        type="email"
                                                        name="email"
                                                        class="form-control form-control-sm"
                                                        placeholder="{{ 'zanders.stockNotification.emailPlaceholder'|trans }}"
                                                        value="{{ context.customer ? context.customer.email : '' }}"
                                                        required="required"
                                                        aria-label="{{ 'zanders.stockNotification.emailPlaceholder'|trans }}"
                                                    >
                                                    <button class="btn btn-primary btn-sm zanders-pd-notify-btn" type="submit">
                                                        {{ 'zanders.stockNotification.notifyMeButton'|trans }}
                                                    </button>
                                                </div>
                                                <small class="form-text text-muted d-block mt-1">
                                                    {{ 'zanders.stockNotification.privacyNotice'|trans }}
                                                </small>
                                            </form>
                                        </div>
                                    {% else %}
                                        {% set buyable = product.available and product.childCount <= 0 and product.calculatedMaxPurchase > 0 %}
                                        <form
                                            action="{{ path('frontend.checkout.line-item.add') }}"
                                            method="post"
                                            class="zanders-pd-buy-form"
                                            data-add-to-cart="true"
                                        >

                                            <input type="hidden" name="redirectTo" value="frontend.detail.page">
                                            <input
                                                type="hidden"
                                                name="redirectParameters"
                                                data-redirect-parameters="true"
                                                value="{{ {productId: product.id}|json_encode }}"
                                            >
                                            <input type="hidden" name="lineItems[{{ product.id }}][id]" value="{{ product.id }}">
                                            <input type="hidden" name="lineItems[{{ product.id }}][type]" value="product">
                                            <input type="hidden" name="lineItems[{{ product.id }}][referencedId]" value="{{ product.id }}">
                                            <input type="hidden" name="lineItems[{{ product.id }}][stackable]" value="1">
                                            <input type="hidden" name="lineItems[{{ product.id }}][removable]" value="1">
                                            <input type="hidden" name="product-name" value="{{ product.translated.name }}">
                                            <input type="hidden" name="brand-name" value="{{ product.manufacturer.translated.name|default('') }}">
                                            <div class="zanders-pd-action-bar">
                                                <div class="zanders-pd-qty-group">
                                                    <label for="zandersQtyInput" class="zanders-pd-qty-label">{{ 'zanders.product.qty'|trans|striptags }}</label>
                                                    <input
                                                        type="number"
                                                        id="zandersQtyInput"
                                                        name="lineItems[{{ product.id }}][quantity]"
                                                        class="zanders-pd-qty-input"
                                                        min="{{ quantityFrom }}"
                                                        max="{{ quantityTo }}"
                                                        step="{{ quantityStep }}"
                                                        value="{{ quantityFrom }}"
                                                    >
                                                </div>

                                                {% if buyable %}
                                                    <button type="submit" class="zanders-pd-add-to-cart-btn">
                                                        {{ 'zanders.product.addToCart'|trans }}
                                                    </button>
                                                {% else %}
                                                    <button type="button" class="zanders-pd-add-to-cart-btn is-disabled" disabled>
                                                        {{ 'zanders.detail.outOfStock'|trans }}
                                                    </button>
                                                {% endif %}
                                            </div>
                                        </form>
                                    {% endif %}
                                {% endif %}
                            {% else %}
                                <div class="zanders-pd-login-price-wrap">
                                    <a
                                        href="{{ path('frontend.account.login.page') }}"
                                        class="btn zanders-btn-login-price zanders-pd-btn-login-price"
                                        title="{{ 'zanders.product.loginToViewPrice'|trans|striptags }}"
                                    >
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                        </svg>
                                        <span>{{ 'zanders.product.loginToViewPrice'|trans }}</span>
                                    </a>
                                </div>
                            {% endif %}

                            {# ── Section: Quick Overview (Static content) ── #}
                            <div class="zanders-pd-overview-card">
                                <div class="zanders-pd-card-header">
                                    {{ 'zanders.detail.quickOverview'|trans }}
                                </div>
                                <div class="zanders-pd-card-body">
                                    <p class="zanders-pd-overview-text">{{ product.translated.name }}</p>
                                </div>
                            </div>

                            {# ── Section: Features (Dynamic Product Description) ── #}
                            {% set productDescription = product.translated.description|default(product.description)|default('') %}
                            {% if productDescription %}
                                <div class="zanders-pd-features-card">
                                    <div class="zanders-pd-features-header">
                                        {{ 'zanders.detail.features'|trans }}
                                    </div>
                                    <div class="zanders-pd-features-body">
                                        {% if '<' in productDescription and '>' in productDescription %}
                                            {{ productDescription|sw_sanitize }}
                                        {% else %}
                                            {{ productDescription|nl2br }}
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}

                            {# ── Button: Create Customer Quote (Static) ── #}
                            <div class="zanders-pd-quote-wrapper">
                                <button type="button" class="zanders-pd-quote-btn">
                                    {{ 'zanders.detail.createCustomerQuote'|trans }}
                                </button>
                            </div>

                            {# ── Warning Box & Modal: Product Warning Information ── #}
                            {% set warningLabel = page.extensions.zandersWarningLabel %}

                            {% if warningLabel %}
                                <div class="zanders-pd-warning-box">
                                    <div class="zanders-pd-warning-icon">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                            <path d="M12 2.5L1.5 21H22.5L12 2.5Z" fill="#F59E0B" stroke="#000000" stroke-width="1.6" stroke-linejoin="round"/>
                                            <path d="M12 8.5V14" stroke="#000000" stroke-width="2" stroke-linecap="round"/>
                                            <circle cx="12" cy="17.5" r="1.2" fill="#000000"/>
                                        </svg>
                                    </div>
                                    <div class="zanders-pd-warning-content">
                                        <strong class="zanders-pd-warning-label">{{ 'zanders.detail.warningLabel'|trans }}</strong>
                                        <button type="button" class="zanders-pd-warning-link" data-warning-modal-open="true" aria-haspopup="dialog">
                                            {{ warningLabel.name|sw_sanitize }}
                                        </button>
                                    </div>
                                </div>

                                {# ── Warning Popup Modal ── #}
                                <div class="zanders-warning-modal-backdrop" id="zandersWarningModal" data-warning-modal="true" aria-hidden="true" role="dialog" aria-modal="true">
                                    <div class="zanders-warning-modal-dialog">
                                        <button type="button" class="zanders-warning-modal-close" data-warning-modal-close="true" aria-label="{{ 'zanders.detail.closeWarning'|trans|striptags }}">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                        <div class="zanders-warning-modal-icon">
                                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M12 2.5L1.5 21H22.5L12 2.5Z" fill="#F59E0B" stroke="#000000" stroke-width="1.6" stroke-linejoin="round"/>
                                                <path d="M12 8.5V14" stroke="#000000" stroke-width="2" stroke-linecap="round"/>
                                                <circle cx="12" cy="17.5" r="1.2" fill="#000000"/>
                                            </svg>
                                        </div>
                                        <div class="zanders-warning-modal-content">
                                            <p class="zanders-warning-modal-text">
                                                <strong>{{ 'zanders.detail.warningLabel'|trans }}</strong> {{ warningLabel.message|zanders_format_warning_message }}
                                            </p>
                                            {% set warningUrl = warningLabel.url|default(warningLabel.get('url'))|default('') %}
                                            {% if warningUrl is not empty %}
                                                {% set targetUrl = (warningUrl starts with 'http://' or warningUrl starts with 'https://') ? warningUrl : ('https://' ~ warningUrl) %}
                                                <p class="zanders-warning-modal-text mt-1">
                                                    <a href="{{ targetUrl }}" target="_blank" rel="noopener noreferrer" class="zanders-warning-link">
                                                        {{ warningUrl|zanders_format_warning_url_label }}
                                                    </a>
                                                </p>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {# ── Button: Email to a Friend (Static) ── #}
                            <div class="zanders-pd-email-wrapper">
                                <button type="button" class="zanders-pd-email-btn">
                                    {{ 'zanders.detail.emailToFriend'|trans }}
                                </button>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            {# ── Bottom Section: ADDITIONAL INFORMATION ── #}
            {% set customFields = product.translated.customFields|default(product.customFields)|default({}) %}
            {% set upcValue = product.ean|default(null) %}

            {# Build property group map for fast, reliable lookup #}
            {% set propertyMap = {} %}
            {% if product.sortedProperties %}
                {% for group in product.sortedProperties %}
                    {% set grpName = group.translated.name|default(group.name)|trim %}
                    {% set optValues = group.options|map(option => option.translated.name|default(option.name))|join(', ') %}
                    {% set propertyMap = propertyMap|merge({(grpName): optValues}) %}
                {% endfor %}
            {% elseif product.properties %}
                {% for option in product.properties %}
                    {% set grp = option.group %}
                    {% if grp %}
                        {% set grpName = grp.translated.name|default(grp.name)|trim %}
                        {% set optName = option.translated.name|default(option.name) %}
                        {% set propertyMap = propertyMap|merge({(grpName): optName}) %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            {% set sightsValue = propertyMap['Sights']|default(null) %}
            {% set caliberValue = propertyMap['Caliber']|default(null) %}
            {% set metalColorValue = propertyMap['Metal Color']|default(null) %}
            {% set stockColorValue = propertyMap['Stock Color']|default(null) %}
            {% set typeActionValue = propertyMap['Type Action']|default(null) %}
            {% set metalFinishValue = propertyMap['Metal Finish']|default(null) %}
            {% set stockMaterialValue = propertyMap['Stock Material']|default(null) %}

            {% set barrelLengthValue = customFields.barrel_length is defined and customFields.barrel_length is not null and customFields.barrel_length != '' ? customFields.barrel_length ~ '"' : null %}
            {% set rateOfTwistValue = customFields.rate_of_twist is defined and customFields.rate_of_twist is not null and customFields.rate_of_twist != '' ? customFields.rate_of_twist : null %}
            {% set overallLengthValue = customFields.overall_length is defined and customFields.overall_length is not null and customFields.overall_length != '' ? customFields.overall_length ~ '"' : null %}
            {% set magazineCapacityValue = customFields.magazine_capacity is defined and customFields.magazine_capacity is not null and customFields.magazine_capacity != '' ? customFields.magazine_capacity : null %}

            {% set hasAdditionalInfo = product.manufacturer
                or upcValue
                or sightsValue
                or (product.weight and product.weight > 0)
                or caliberValue
                or metalColorValue
                or stockColorValue
                or typeActionValue
                or metalFinishValue
                or barrelLengthValue
                or rateOfTwistValue
                or overallLengthValue
                or stockMaterialValue
                or (magazineCapacityValue is not null)
                or product.manufacturerNumber
                or (product.height and product.height > 0)
                or (product.width and product.width > 0)
                or (product.length and product.length > 0)
                or product.releaseDate
                or product.deliveryTime %}

            {% if hasAdditionalInfo %}
                <section class="zanders-pd-additional-info" aria-labelledby="zanders-additional-info-title">
                    <h2 id="zanders-additional-info-title" class="zanders-pd-additional-title">
                        {{ 'zanders.detail.additionalInformation'|trans }}
                    </h2>
                    <div class="zanders-pd-additional-divider"></div>

                    <table class="zanders-pd-info-table">
                        <tbody>

                            {% if product.manufacturer %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.manufacturer'|trans }}</th>
                                    <td class="zanders-pd-info-value">
                                        <span class="zanders-pd-mfr-link">{{ product.manufacturer.translated.name|default(product.manufacturer.name) }}</span>
                                        {% if product.manufacturer.translated.description %}
                                            <div class="zanders-pd-mfr-address">
                                                {{ product.manufacturer.translated.description|sw_sanitize }}
                                            </div>
                                        {% endif %}
                                        {% if product.manufacturer.link %}
                                            <a href="{{ product.manufacturer.link }}" target="_blank" rel="noopener" class="zanders-pd-mfr-website">
                                                {{ product.manufacturer.link|replace({'https://': '', 'http://': ''}) }}
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endif %}

                            {% if upcValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.upc'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ upcValue }}</td>
                                </tr>
                            {% endif %}

                            {% if sightsValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.sights'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ sightsValue }}</td>
                                </tr>
                            {% endif %}

                            {% if product.weight and product.weight > 0 %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.weight'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ product.weight + 0 }}</td>
                                </tr>
                            {% endif %}

                            {% if caliberValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.caliber'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ caliberValue }}</td>
                                </tr>
                            {% endif %}

                            {% if metalColorValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.metalColor'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ metalColorValue }}</td>
                                </tr>
                            {% endif %}

                            {% if stockColorValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.stockColor'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ stockColorValue }}</td>
                                </tr>
                            {% endif %}

                            {% if typeActionValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.typeAction'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ typeActionValue }}</td>
                                </tr>
                            {% endif %}

                            {% if metalFinishValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.metalFinish'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ metalFinishValue }}</td>
                                </tr>
                            {% endif %}

                            {% if barrelLengthValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.barrelLength'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ barrelLengthValue }}</td>
                                </tr>
                            {% endif %}

                            {% if rateOfTwistValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.rateOfTwist'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ rateOfTwistValue }}</td>
                                </tr>
                            {% endif %}

                            {% if overallLengthValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.overallLength'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ overallLengthValue }}</td>
                                </tr>
                            {% endif %}

                            {% if stockMaterialValue %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.stockMaterial'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ stockMaterialValue }}</td>
                                </tr>
                            {% endif %}

                            {% if magazineCapacityValue is not null %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.magazineCapacity'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ magazineCapacityValue }}</td>
                                </tr>
                            {% endif %}

                            {% if product.manufacturerNumber %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.manufacturerPartNumber'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ product.manufacturerNumber }}</td>
                                </tr>
                            {% endif %}

                            {% if (product.height and product.height > 0) or (product.width and product.width > 0) or (product.length and product.length > 0) %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.packagingDimensions'|trans }}</th>
                                    <td class="zanders-pd-info-value">
                                        {{ product.height|default('—') }} x {{ product.width|default('—') }} x {{ product.length|default('—') }}
                                    </td>
                                </tr>
                            {% endif %}

                            {% if product.releaseDate %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.releaseDate'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ product.releaseDate|format_date('medium') }}</td>
                                </tr>
                            {% endif %}

                            {% if product.deliveryTime %}
                                <tr class="zanders-pd-info-row">
                                    <th scope="row" class="zanders-pd-info-label">{{ 'zanders.detail.deliveryTime'|trans }}</th>
                                    <td class="zanders-pd-info-value">{{ product.deliveryTime.translated.name }}</td>
                                </tr>
                            {% endif %}

                            {% if product.sortedProperties %}
                                {% for group in product.sortedProperties %}
                                    {% set groupName = group.translated.name|default(group.name)|trim %}
                                    {% if groupName not in ['Sights', 'Caliber', 'Metal Color', 'Stock Color', 'Type Action', 'Metal Finish', 'Stock Material', 'UPC', 'EAN', 'Manufacturer Part Number', 'MPN'] %}
                                        {% set optionValues = group.options|map(option => option.translated.name|default(option.name))|join(', ') %}
                                        {% if optionValues %}
                                            <tr class="zanders-pd-info-row">
                                                <th scope="row" class="zanders-pd-info-label">{{ groupName }}</th>
                                                <td class="zanders-pd-info-value">{{ optionValues }}</td>
                                            </tr>
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}

                            {% for key, value in customFields %}
                                {% if key not in ['barrel_length', 'rate_of_twist', 'overall_length', 'magazine_capacity', 'upc', 'custom_upc', 'custom_weight', 'custom_sights', 'custom_caliber', 'custom_metal_color', 'custom_stock_color', 'custom_type_action', 'custom_metal_finish', 'custom_stock_material', 'custom_checkering', 'custom_detachable_magazine', 'custom_hinged_floorplate', 'custom_packaging_dimensions', 'custom_recoil_pad', 'custom_swivel_studs', 'custom_barrel_length', 'custom_rate_of_twist', 'custom_overall_length', 'custom_magazine_capacity', 'product_warning_title', 'product_warning_message', 'product_region_restriction_enabled', 'product_restricted_states'] %}
                                    {% set fieldLabel = key|replace({'custom_': '', '_': ' '})|trim %}
                                    {% if value is not null and value is not empty and value is not same as false %}
                                        <tr class="zanders-pd-info-row">
                                            <th scope="row" class="zanders-pd-info-label">{{ fieldLabel }}</th>
                                            <td class="zanders-pd-info-value">
                                                {% if value is iterable %}
                                                    {{ value|join(', ') }}
                                                {% elseif value is same as true %}
                                                    Y
                                                {% else %}
                                                    {{ value }}
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endif %}
                            {% endfor %}

                        </tbody>
                    </table>
                </section>
            {% endif %}

            {# ── Cross-Selling Section ── #}
            {% set hasCrossSellingSlot = false %}
            {% if page.cmsPage %}
                {% for section in page.cmsPage.sections %}
                    {% for block in section.blocks %}
                        {% for slot in block.slots %}
                            {% if slot.type == 'cross-selling' %}
                                {% set hasCrossSellingSlot = true %}
                                <section class="zanders-pd-cross-selling mt-5 mb-5" aria-label="Cross Selling">
                                    {% sw_include '@Storefront/storefront/element/cms-element-cross-selling.html.twig' with {
                                        element: slot
                                    } %}
                                </section>
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                {% endfor %}
            {% endif %}

            {% if not hasCrossSellingSlot %}
                <section class="zanders-pd-cross-selling mt-5 mb-5" aria-label="Cross Selling">
                    {% sw_include '@Storefront/storefront/element/cms-element-cross-selling.html.twig' with {
                        fallbackProduct: product
                    } %}
                </section>
            {% endif %}

        </div>{# /zanders-container-fluid #}
    </div>{# /zanders-product-detail-wrapper #}
{% endblock %}
