{% sw_extends '@Storefront/storefront/page/account/order-history/order-item.html.twig' %}

{% block page_account_order_item_context_menu_cancel_order %}
    {{ parent() }}

    {# Dedicated Print Order Action in Dropdown #}
    <a class="dropdown-item order-table-header-context-menu-content-link order-print-action-link"
       href="{{ path('frontend.account.order.print', { orderId: order.id }) }}"
       target="_blank"
       rel="noopener">
        {% sw_icon 'printer' style { size: 'sm' } %}
        {{ 'account.orderPrintOrder'|trans|default('Print Order') }}
    </a>

    {# Fetch Invoice Document (order.documents) #}
    {% set invoiceDocument = null %}
    {% if order.documents and order.documents|length > 0 %}
        {% for doc in order.documents|sort((a, b) => b.createdAt <=> a.createdAt) %}
            {% if invoiceDocument is null %}
                {% set docType = doc.documentType.technicalName|default(doc.typeName|default('')) %}
                {% if docType == 'invoice' or docType == 'zugferd_invoice' %}
                    {% set invoiceDocument = doc %}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}

    {% if invoiceDocument %}
        {% set invoiceUrl = path('frontend.account.order.single.document', { documentId: invoiceDocument.id, deepLinkCode: invoiceDocument.deepLinkCode }) %}
        <a class="dropdown-item order-table-header-context-menu-content-link order-print-invoice-action-link"
           href="{{ invoiceUrl }}"
           data-print-invoice="true"
           data-print-invoice-url="{{ invoiceUrl }}"
           target="_blank"
           rel="noopener">
            {% sw_icon 'file' style { size: 'sm' } %}
            {{ 'account.orderPrintInvoice'|trans|default('Print Invoice') }}
        </a>
    {% endif %}
{% endblock %}

{# Header: Shipping Method Column #}
{% block page_account_order_item_order_table_header_cell_shipping_method %}
    {% if order.deliveries|length > 0 or order.primaryOrderDelivery %}
        <div class="col-12 col-sm order-table-header-order-table-header-cell order-table-header-order-table-header-cell-shipping-method">
            {{ 'account.orderShippingMethod'|trans|sw_sanitize }}
        </div>
    {% endif %}
{% endblock %}

{# Header: Action Column #}
{% block page_account_order_item_order_table_header_cell_placeholder %}
    <div class="col-12 col-md-auto order-table-header-order-table-header-cell order-table-header-order-table-header-cell-action">
        {{ 'account.orderAction'|trans|default('Action') }}
    </div>
{% endblock %}

{# Body: Shipping Method Column #}
{% block page_account_order_item_order_table_body_cell_shipping_method %}
    {% if order.deliveries|length > 0 or order.primaryOrderDelivery %}
        <div class="col-12 col-sm order-table-header-order-table-body-cell order-table-header-order-table-body-cell-shipping-method">
            <strong class="order-table-header-label">
                {{ 'account.orderShippingMethod'|trans|sw_sanitize }}{{ 'account.colonCharacter'|trans|sw_sanitize }}
            </strong>
            <span class="order-table-body-value">
                {% if order.deliveries|length > 0 and (order.deliveries|first).shippingMethod %}
                    {{ (order.deliveries|first).shippingMethod.translated.name|default((order.deliveries|first).shippingMethod.name) }}
                {% elseif order.primaryOrderDelivery and order.primaryOrderDelivery.shippingMethod %}
                    {{ order.primaryOrderDelivery.shippingMethod.translated.name|default(order.primaryOrderDelivery.shippingMethod.name) }}
                {% else %}
                    -
                {% endif %}
            </span>
        </div>
    {% endif %}
{% endblock %}

{# Body: Action Column (Buttons only belong here under Action) #}
{% block page_account_order_item_order_table_body_cell_toggle_order_details %}
    <div class="col-12 col-md-auto order-item order-item-actions order-table-header-order-table-body-cell">
        {# Show / Hide Details Button #}
        {% block page_account_order_item_order_table_body_cell_toggle_order_details_button %}
            <button class="btn btn-outline-secondary btn-sm order-hide-btn collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#order{{ order.orderNumber }}"
                    aria-expanded="false"
                    aria-controls="order{{ order.orderNumber }}"
                    title="{{ 'account.orderActionView'|trans|sw_sanitize }}">
                {% block page_account_order_item_order_table_body_cell_toggle_order_details_button_text %}
                    <span class="order-hide-btn-text">{{ 'account.orderActionHide'|trans|sw_sanitize }}</span>
                    <span class="order-view-btn-text">{{ 'account.orderActionView'|trans|sw_sanitize }}</span>
                {% endblock %}
            </button>
        {% endblock %}

        {# Print Order Button #}
        <a href="{{ path('frontend.account.order.print', { orderId: order.id }) }}"
           target="_blank"
           rel="noopener"
           class="btn btn-outline-secondary btn-sm order-print-btn"
           title="{{ 'account.orderPrintOrder'|trans|default('Print Order') }}">
            {% sw_icon 'printer' style { size: 'sm' } %}
            <span>{{ 'account.orderPrintOrder'|trans|default('Print Order') }}</span>
        </a>

        {# Fetch Invoice Document (order.documents) #}
        {% set invoiceDocument = null %}
        {% if order.documents and order.documents|length > 0 %}
            {% for doc in order.documents|sort((a, b) => b.createdAt <=> a.createdAt) %}
                {% if invoiceDocument is null %}
                    {% set docType = doc.documentType.technicalName|default(doc.typeName|default('')) %}
                    {% if docType == 'invoice' or docType == 'zugferd_invoice' %}
                        {% set invoiceDocument = doc %}
                    {% endif %}
                {% endif %}
            {% endfor %}
        {% endif %}

        {# Print Invoice Button or Pending State Notice #}
        {% if invoiceDocument %}
            {% set invoiceUrl = path('frontend.account.order.single.document', { documentId: invoiceDocument.id, deepLinkCode: invoiceDocument.deepLinkCode }) %}
            <a href="{{ invoiceUrl }}"
               data-print-invoice="true"
               data-print-invoice-url="{{ invoiceUrl }}"
               target="_blank"
               rel="noopener"
               class="btn btn-outline-secondary btn-sm order-invoice-btn order-print-invoice-btn"
               title="{{ 'account.orderPrintInvoice'|trans|default('Print Invoice') }}">
                {% sw_icon 'file' style { size: 'sm' } %}
                <span>{{ 'account.orderPrintInvoice'|trans|default('Print Invoice') }}</span>
            </a>
        {% else %}
            <span class="order-invoice-pending-notice"
                  title="{{ 'account.orderInvoicePending'|trans|default('Invoice Pending') }}">
                {% sw_icon 'file' style { size: 'sm' } %}
                <span>{{ 'account.orderInvoicePending'|trans|default('Invoice Pending') }}</span>
            </span>
        {% endif %}
    </div>
{% endblock %}
