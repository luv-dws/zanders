{% sw_extends '@Storefront/storefront/layout/header/search.html.twig' %}

{% block layout_header_search %}
    <div class="header-search zanders-header-search m-0">
        <form action="{{ path('frontend.search.page') }}"
              method="get"
              data-search-widget="true"
              data-url="{{ path('frontend.search.suggest') }}?search="
              class="header-search-form js-search-form">
            <div class="zanders-search-group d-flex align-items-center">
                <button type="submit"
                        class="btn zanders-search-btn"
                        aria-label="{{ 'header.searchButton'|trans|striptags }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
                <input
                    type="search"
                    id="header-main-search-input"
                    name="search"
                    class="form-control header-search-input zanders-search-input"
                    autocomplete="off"
                    autocapitalize="off"
                    placeholder="{{ 'zanders.header.searchPlaceholder'|trans|striptags }}"
                    aria-label="{{ 'zanders.header.searchPlaceholder'|trans|striptags }}"
                    value="{{ page.searchTerm }}">
            </div>
        </form>
    </div>
{% endblock %}
