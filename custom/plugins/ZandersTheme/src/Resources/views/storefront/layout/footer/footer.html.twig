{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{% block layout_footer_inner_container %}
    <div class="zanders-footer">
        {# Top Section: 4 Columns (Company, Resources, Contact Info, Logo) #}
        <div class="zanders-footer-top">
            <div class="zanders-container-fluid">
                <div class="zanders-footer-row">
                    {# Column 1: COMPANY #}
                    <div class="zanders-footer-col zanders-footer-company-col">
                        <h4 class="zanders-footer-col-title">COMPANY</h4>
                        <ul class="zanders-footer-list">
                            <li class="zanders-footer-item">About Us</li>
                            <li class="zanders-footer-item">Terms &amp; Conditions</li>
                            <li class="zanders-footer-item">Freight Policy</li>
                            <li class="zanders-footer-item">Job Opportunities</li>
                            <li class="zanders-footer-item">Staff</li>
                            <li class="zanders-footer-item">Manufacturers</li>
                        </ul>
                    </div>

                    {# Column 2: RESOURCES #}
                    <div class="zanders-footer-col zanders-footer-resources-col">
                        <h4 class="zanders-footer-col-title">RESOURCES</h4>
                        <ul class="zanders-footer-list">
                            <li class="zanders-footer-item">Forms</li>
                            <li class="zanders-footer-item">Press Releases</li>
                            <li class="zanders-footer-item">Recalls</li>
                            <li class="zanders-footer-item">Industry Links</li>
                            <li class="zanders-footer-item">Tutorials</li>
                            <li class="zanders-footer-item">Eley</li>
                        </ul>
                    </div>

                    {# Column 3: CONTACT INFO #}
                    <div class="zanders-footer-col zanders-footer-contact-col">
                        <div class="zanders-footer-contact-list">
                            <div class="zanders-footer-contact-item">
                                <div class="zanders-footer-icon-circle" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#991020" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                                    </svg>
                                </div>
                                <div class="zanders-footer-contact-details">
                                    <span class="zanders-footer-phone-number">800.851.4373</span>
                                </div>
                            </div>
                            <div class="zanders-footer-contact-item">
                                <div class="zanders-footer-icon-circle" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#991020" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                </div>
                                <div class="zanders-footer-contact-details">
                                    <span class="zanders-footer-hours-days">Mon - Fri</span>
                                    <span class="zanders-footer-hours-time">8:00AM to 4:30PM CST</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Column 4: LOGO #}
                    <div class="zanders-footer-col zanders-footer-logo-col">
                        <div class="zanders-footer-logo-wrap">
                            <img src="{{ asset('assets/zanders-logo.png', 'theme') }}"
                                 alt="Zanders America's Distribution Company Since 1962"
                                 class="zanders-footer-logo-img"
                                 width="260"
                                 height="137"
                                 loading="lazy">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Bottom Sub-Footer: Red Bar with Social & Legal/Copyright #}
        <div class="zanders-footer-bottom">
            <div class="zanders-container-fluid">
                <div class="zanders-footer-bottom-row">
                    <div class="zanders-footer-bottom-left">
                        <span class="zanders-footer-stay-connected">Stay connected</span>
                        <div class="zanders-footer-socials" aria-label="Social media">
                            <span class="zanders-footer-social-icon" aria-label="Facebook">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="#ffffff">
                                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                </svg>
                            </span>
                            <span class="zanders-footer-social-icon" aria-label="Instagram">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="#ffffff">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                            </span>
                            <span class="zanders-footer-social-icon" aria-label="Twitter">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="#ffffff">
                                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.936 9.936 0 0024 4.59z"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                    <div class="zanders-footer-bottom-right">
                        <div class="zanders-footer-copyright">&copy; 1996-2026 Zanders Sporting Goods</div>
                        <div class="zanders-footer-disclaimer">Zanders Sporting Goods is a wholesale firearms distributor selling only to federally licensed dealers</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
