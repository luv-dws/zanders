{% sw_extends '@Storefront/storefront/layout/header/actions/cart-widget.html.twig' %}

{% block layout_header_actions_cart_widget %}
    <div class="zanders-cart-wrapper d-flex align-items-center gap-2">
        <div class="zanders-cart-circle-container position-relative">
            <span class="zanders-cart-circle">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </span>
            {% if page.cart and page.cart.lineItems|length > 0 %}
                <span class="zanders-cart-count-badge">
                    {{ page.cart.lineItems|length }}
                </span>
            {% endif %}
        </div>
        <span class="zanders-cart-price">
            {% if page.cart and page.cart.price and page.cart.price.positionPrice > 0 %}
                {{ page.cart.price.positionPrice|currency }}
            {% else %}
                {{ 0|currency }}
            {% endif %}
        </span>
    </div>
{% endblock %}
