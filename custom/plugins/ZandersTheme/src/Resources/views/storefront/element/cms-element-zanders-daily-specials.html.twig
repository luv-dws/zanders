{% block element_zanders_daily_specials %}
    {% set products = (element.data and element.data.products) ? element.data.products : zanders_get_daily_specials(12) %}
    {% set isUserLoggedIn = context.customer is defined and context.customer and not context.customer.guest %}

    {% set sliderOptions = {
        slider: {
            nav: false,
            dots: false,
            gutter: 20,
            mouseDrag: true,
            controls: true,
            rewind: true,
            loop: false,
            responsive: {
                0: { items: 1 },
                576: { items: 2 },
                768: { items: 3 },
                1200: { items: 4 }
            }
        }
    } %}

    <div class="cms-element-zanders-daily-specials zanders-featured-section zanders-daily-specials-section">
        <div class="zanders-featured-header">
            <h2 class="zanders-featured-title">{{ 'zanders.dailySpecials.title'|trans|default('ZANDERS DAILY SPECIALS') }}</h2>
            <div class="zanders-featured-title-line" aria-hidden="true"></div>
        </div>

        {% if products|length > 0 %}
            <div class="base-slider product-slider zanders-product-slider"
                 data-product-slider="true"
                 data-product-slider-options="{{ sliderOptions|json_encode }}"
                 role="region"
                 aria-label="{{ 'zanders.dailySpecials.title'|trans|default('ZANDERS DAILY SPECIALS') }}">

                <div class="product-slider-container" data-product-slider-container="true">
                    {% for product in products %}
                        <div class="product-slider-item">
                            {% sw_include '@ZandersTheme/storefront/component/product/card/zanders-card.html.twig' with {
                                product: product,
                                isUserLoggedIn: isUserLoggedIn,
                                context: context
                            } %}
                        </div>
                    {% endfor %}
                </div>

                <div class="product-slider-controls-container">
                    <div class="base-slider-controls" data-product-slider-controls="true">
                        <button type="button" class="base-slider-controls-prev product-slider-controls-prev" aria-label="Previous">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="15 18 9 12 15 6"></polyline>
                            </svg>
                        </button>
                        <button type="button" class="base-slider-controls-next product-slider-controls-next" aria-label="Next">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
