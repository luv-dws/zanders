{% block element_zanders_daily_specials %}
    {% set products = (element.data and element.data.products) ? element.data.products : zanders_get_daily_specials(24) %}
    {% set isUserLoggedIn = context.customer is defined and context.customer and not context.customer.guest %}

    <div class="cms-element-zanders-daily-specials zanders-featured-section zanders-daily-specials-section">
        <div class="zanders-featured-header">
            <h2 class="zanders-featured-title">{{ 'zanders.dailySpecials.title'|trans|default('ZANDERS DAILY SPECIALS') }}</h2>
            <div class="zanders-featured-title-line" aria-hidden="true"></div>
        </div>

        {% if products|length > 0 %}
            <div class="zanders-featured-grid">
                {% for product in products %}
                    <div class="zanders-featured-grid-item">
                        {% sw_include '@Storefront/storefront/component/product/card/zanders-card.html.twig' with {
                            product: product,
                            isUserLoggedIn: isUserLoggedIn,
                            context: context
                        } %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
