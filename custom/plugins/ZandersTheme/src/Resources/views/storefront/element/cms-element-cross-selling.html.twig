{% sw_extends '@Storefront/storefront/element/cms-element-cross-selling.html.twig' %}

{% block cms_element_cross_selling_tabs_inner %}
    {% set isUserLoggedIn = context.customer is defined and context.customer and not context.customer.guest %}

    
    {# Check for cross-selling groups in element data #}
    {% set crossSellingItems = [] %}
    {% if element.data.crossSellings.elements is defined and element.data.crossSellings.elements|length > 0 %}
        {% set crossSellingItems = element.data.crossSellings.elements|filter(item => item.total > 0 and item.crossSelling.active == true) %}
    {% endif %}

    {# Fallback if no cross-sellings assigned: fetch 8 products to showcase alternative products #}
    {% if crossSellingItems|length == 0 and fallbackProduct is defined %}
        {% set fallbackList = zanders_get_products(8) %}
        {% if fallbackList|length > 0 %}
            {% set fallbackItem = {
                crossSelling: {
                    name: 'zanders.crossSelling.alternativeProducts'|trans,
                    translated: { name: 'zanders.crossSelling.alternativeProducts'|trans },
                    id: 'fallback'
                },
                products: fallbackList,
                total: fallbackList|length
            } %}
            {% set crossSellingItems = [fallbackItem] %}
        {% endif %}
    {% endif %}

    {% if crossSellingItems|length > 0 %}

        <div class="zanders-cross-selling-wrapper">
            {% for item in crossSellingItems %}
                {% set crossSelling = item.crossSelling %}
                {% set products = item.products %}
                {% set sectionId = 'zanders-cross-' ~ (crossSelling.id|default(loop.index)) %}

                <div class="zanders-cross-group" id="{{ sectionId }}" data-zanders-cross-selling="true">
                    {# Section Header #}
                    <div class="zanders-cross-header">
                        <h2 class="zanders-cross-title">
                            {{ (crossSelling.name ?: crossSelling.translated.name)|default('zanders.crossSelling.alternativeProducts'|trans)|upper }}
                        </h2>

                        <div class="zanders-cross-header-actions">
                            <div class="zanders-cross-nav-group">
                                <button type="button"
                                        class="zanders-cross-nav-btn zanders-cross-nav-prev"
                                        data-cross-prev="true"
                                        title="{{ 'zanders.crossSelling.previous'|trans|striptags }}"
                                        aria-label="{{ 'zanders.crossSelling.previous'|trans|striptags }}">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="15 18 9 12 15 6"></polyline>
                                    </svg>
                                </button>
                                <button type="button"
                                        class="zanders-cross-nav-btn zanders-cross-nav-next"
                                        data-cross-next="true"
                                        title="{{ 'zanders.crossSelling.next'|trans|striptags }}"
                                        aria-label="{{ 'zanders.crossSelling.next'|trans|striptags }}">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    {# Slider Carousel Track #}
                    <div class="zanders-cross-carousel">
                        <div class="zanders-cross-track" data-cross-track="true">
                            {% for product in products %}
                                <div class="zanders-cross-slide-item">
                                    {% sw_include '@Storefront/storefront/component/product/card/zanders-card.html.twig' with {
                                        product: product,
                                        context: context,
                                        isUserLoggedIn: isUserLoggedIn
                                    } %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
