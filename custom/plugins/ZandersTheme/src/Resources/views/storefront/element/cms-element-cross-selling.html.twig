{% sw_extends '@Storefront/storefront/element/cms-element-cross-selling.html.twig' %}

{% block cms_element_cross_selling_tabs_inner %}
    {% set isUserLoggedIn = context.customer is defined and context.customer and not context.customer.guest %}

    <style>
        .zanders-cross-header-actions {
            display: inline-flex !important;
            align-items: center !important;
            gap: 12px !important;
        }
        .zanders-cross-stock-toggle-group {
            display: inline-flex !important;
            align-items: center !important;
        }
        .zanders-cross-stock-toggle-btn {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 7px !important;
            height: 34px !important;
            padding: 0 14px !important;
            background-color: #ffffff !important;
            color: #991020 !important;
            border: 1px solid #991020 !important;
            border-radius: 2px !important;
            font-size: 0.6875rem !important;
            font-weight: 700 !important;
            letter-spacing: 0.5px !important;
            text-transform: uppercase !important;
            text-decoration: none !important;
            white-space: nowrap !important;
            line-height: 1 !important;
            cursor: pointer !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04) !important;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
            outline: none !important;
        }
        .zanders-cross-stock-toggle-btn .zanders-cross-stock-toggle-icon {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            flex-shrink: 0 !important;
            line-height: 1 !important;
        }
        .zanders-cross-stock-toggle-btn .zanders-cross-stock-toggle-icon svg {
            display: block !important;
            width: 14px !important;
            height: 14px !important;
            transition: transform 0.2s ease !important;
        }
        .zanders-cross-stock-toggle-btn .zanders-cross-stock-toggle-icon .icon-eye {
            display: inline-block !important;
        }
        .zanders-cross-stock-toggle-btn .zanders-cross-stock-toggle-icon .icon-eye-off {
            display: none !important;
        }
        .zanders-cross-stock-toggle-btn:hover {
            background-color: #fdf2f2 !important;
            border-color: #7d0d1a !important;
            color: #7d0d1a !important;
            box-shadow: 0 2px 5px rgba(153, 16, 32, 0.15) !important;
            transform: translateY(-0.5px) !important;
        }
        .zanders-cross-stock-toggle-btn:hover .zanders-cross-stock-toggle-icon svg {
            transform: scale(1.1) !important;
        }
        .zanders-cross-stock-toggle-btn:active {
            transform: translateY(0) !important;
            box-shadow: 0 1px 2px rgba(153, 16, 32, 0.1) !important;
        }
        /* When button is active (Out of stock items are visible, button action is "HIDE OUT OF STOCK") */
        .zanders-cross-stock-toggle-btn:not(.is-active) {
            background-color: #991020 !important;
            border-color: #991020 !important;
            color: #ffffff !important;
        }
        .zanders-cross-stock-toggle-btn:not(.is-active) .zanders-cross-stock-toggle-icon .icon-eye {
            display: none !important;
        }
        .zanders-cross-stock-toggle-btn:not(.is-active) .zanders-cross-stock-toggle-icon .icon-eye-off {
            display: inline-block !important;
        }
        .zanders-cross-stock-toggle-btn:not(.is-active):hover {
            background-color: #7d0d1a !important;
            border-color: #7d0d1a !important;
            color: #ffffff !important;
            box-shadow: 0 3px 6px rgba(153, 16, 32, 0.25) !important;
        }
        /* When out-of-stock items are hidden, button is white with red border and says "SHOW OUT OF STOCK" */
        .zanders-cross-stock-toggle-btn.is-active {
            background-color: #ffffff !important;
            border-color: #991020 !important;
            color: #991020 !important;
        }
        .zanders-cross-stock-toggle-btn.is-active .zanders-cross-stock-toggle-icon .icon-eye {
            display: inline-block !important;
        }
        .zanders-cross-stock-toggle-btn.is-active .zanders-cross-stock-toggle-icon .icon-eye-off {
            display: none !important;
        }
        .zanders-cross-stock-toggle-btn.is-active:hover {
            background-color: #fdf2f2 !important;
            border-color: #7d0d1a !important;
            color: #7d0d1a !important;
        }
    </style>

    
    {# Check for cross-selling groups in element data #}
    {% set crossSellingItems = [] %}
    {% if element.data.crossSellings.elements is defined and element.data.crossSellings.elements|length > 0 %}
        {% set crossSellingItems = element.data.crossSellings.elements|filter(item => item.total > 0 and item.crossSelling.active == true) %}
    {% endif %}

    {# Fallback if no cross-sellings assigned: fetch 8 products to showcase alternative products #}
    {% if crossSellingItems|length == 0 and fallbackProduct is defined %}
        {% set fallbackList = zanders_get_products(8) %}
        {% if fallbackList|length > 0 %}
            {% set fallbackItem = {
                crossSelling: {
                    name: 'zanders.crossSelling.alternativeProducts'|trans,
                    translated: { name: 'zanders.crossSelling.alternativeProducts'|trans },
                    id: 'fallback'
                },
                products: fallbackList,
                total: fallbackList|length
            } %}
            {% set crossSellingItems = [fallbackItem] %}
        {% endif %}
    {% endif %}

    {% if crossSellingItems|length > 0 %}

        <div class="zanders-cross-selling-wrapper">
            {% for item in crossSellingItems %}
                {% set crossSelling = item.crossSelling %}
                {% set products = item.products %}
                {% set sectionId = 'zanders-cross-' ~ (crossSelling.id|default(loop.index)) %}

                <div class="zanders-cross-group" id="{{ sectionId }}" data-zanders-cross-selling="true">
                    {# Section Header #}
                    <div class="zanders-cross-header">
                        <h2 class="zanders-cross-title">
                            {{ (crossSelling.name ?: crossSelling.translated.name)|default('zanders.crossSelling.alternativeProducts'|trans)|upper }}
                        </h2>

                        <div class="zanders-cross-header-actions">
                            <div class="zanders-cross-stock-toggle-group">
                                <button
                                    type="button"
                                    class="zanders-cross-stock-toggle-btn is-active"
                                    data-cross-stock-toggle="true"
                                    aria-pressed="false"
                                    title="{{ 'zanders.crossSelling.toggleStockTitle'|trans|striptags }}"
                                >
                                    <span class="zanders-cross-stock-toggle-icon" aria-hidden="true">
                                        {# Eye icon #}
                                        <svg class="icon-eye" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                        {# Eye off icon #}
                                        <svg class="icon-eye-off" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                            <line x1="1" y1="1" x2="23" y2="23"></line>
                                        </svg>
                                    </span>
                                    <span
                                        class="zanders-cross-stock-toggle-text"
                                        data-text-hide="{{ 'zanders.crossSelling.hideOutOfStock'|trans|default('zanders.listing.hideOutOfStock'|trans) }}"
                                        data-text-show="{{ 'zanders.crossSelling.showOutOfStock'|trans|default('SHOW OUT OF STOCK ITEMS') }}"
                                    >
                                        {{ 'zanders.crossSelling.showOutOfStock'|trans|default('SHOW OUT OF STOCK ITEMS') }}
                                    </span>
                                </button>
                            </div>
                            <div class="zanders-cross-nav-group">
                                <button
                                    type="button"
                                    class="zanders-cross-nav-btn zanders-cross-nav-prev"
                                    data-cross-prev="true"
                                    title="{{ 'zanders.crossSelling.previous'|trans|striptags }}"
                                    aria-label="{{ 'zanders.crossSelling.previous'|trans|striptags }}"
                                >
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="15 18 9 12 15 6"></polyline>
                                    </svg>
                                </button>
                                <button
                                    type="button"
                                    class="zanders-cross-nav-btn zanders-cross-nav-next"
                                    data-cross-next="true"
                                    title="{{ 'zanders.crossSelling.next'|trans|striptags }}"
                                    aria-label="{{ 'zanders.crossSelling.next'|trans|striptags }}"
                                >
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    {# Slider Carousel Track #}
                    <div class="zanders-cross-carousel">
                        <div class="zanders-cross-track" data-cross-track="true">
                            {% for product in products %}
                                {% set availableStock = product.availableStock is not null ? product.availableStock : (product.stock is not null ? product.stock : 0) %}
                                {% set isAvailable = availableStock > 0 and (product.available is not defined or product.available) %}
                                <div class="zanders-cross-slide-item{% if not isAvailable %} is-out-of-stock{% endif %}" data-in-stock="{{ isAvailable ? '1' : '0' }}">
                                    {% sw_include '@Storefront/storefront/component/product/card/zanders-card.html.twig' with {
                                        product: product,
                                        context: context,
                                        isUserLoggedIn: isUserLoggedIn
                                    } %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# Self-contained resilient inline handler (ensures immediate functionality even before or without external bundle compilation) #}
        <script>
            (function() {
                function initZandersCrossSellingStockToggle() {
                    const groups = document.querySelectorAll('[data-zanders-cross-selling="true"]');
                    groups.forEach(function(group) {
                        const track = group.querySelector('[data-cross-track="true"]');
                        const toggleBtn = group.querySelector('[data-cross-stock-toggle="true"]');
                        const prevBtn = group.querySelector('[data-cross-prev="true"]');
                        const nextBtn = group.querySelector('[data-cross-next="true"]');

                        if (!track) return;

                        function getScrollStep() {
                            const firstVisible = track.querySelector('.zanders-cross-slide-item:not([style*="display: none"])');
                            return firstVisible ? (firstVisible.offsetWidth + 16) : 260;
                        }

                        if (prevBtn && !prevBtn.dataset.boundClick) {
                            prevBtn.dataset.boundClick = 'true';
                            prevBtn.addEventListener('click', function(e) {
                                e.preventDefault();
                                track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
                            });
                        }

                        if (nextBtn && !nextBtn.dataset.boundClick) {
                            nextBtn.dataset.boundClick = 'true';
                            nextBtn.addEventListener('click', function(e) {
                                e.preventDefault();
                                track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
                            });
                        }

                        if (!toggleBtn) return;

                        const toggleText = toggleBtn.querySelector('.zanders-cross-stock-toggle-text');
                        const showText = toggleText ? (toggleText.dataset.textShow || 'SHOW OUT OF STOCK ITEMS') : 'SHOW OUT OF STOCK ITEMS';
                        const hideText = toggleText ? (toggleText.dataset.textHide || 'HIDE OUT OF STOCK ITEMS') : 'HIDE OUT OF STOCK ITEMS';

                        // Check if any items are out of stock
                        const items = track.querySelectorAll('.zanders-cross-slide-item');
                        let hasOutOfStock = false;
                        items.forEach(function(item) {
                            if (item.classList.contains('is-out-of-stock') || item.dataset.inStock === '0' || item.querySelector('.is-out-of-stock') || item.querySelector('[data-in-stock="0"]')) {
                                hasOutOfStock = true;
                            }
                        });

                        // If no out-of-stock items, hide button
                        if (!hasOutOfStock) {
                            toggleBtn.style.display = 'none';
                            return;
                        }

                        toggleBtn.style.display = '';

                        // State: initially hiding out-of-stock items
                        let isHiding = group.dataset.stockHiding !== undefined ? (group.dataset.stockHiding === 'true') : true;

                        function renderState() {
                            group.dataset.stockHiding = isHiding ? 'true' : 'false';
                            items.forEach(function(item) {
                                const isOos = item.classList.contains('is-out-of-stock') || item.dataset.inStock === '0' || item.querySelector('.is-out-of-stock') || item.querySelector('[data-in-stock="0"]');
                                if (isOos) {
                                    item.style.display = isHiding ? 'none' : '';
                                }
                            });

                            toggleBtn.classList.toggle('is-active', isHiding);
                            toggleBtn.setAttribute('aria-pressed', (!isHiding).toString());

                            if (toggleText) {
                                toggleText.textContent = isHiding ? showText : hideText;
                            }
                        }

                        renderState();

                        if (!toggleBtn.dataset.boundClick) {
                            toggleBtn.dataset.boundClick = 'true';
                            toggleBtn.addEventListener('click', function(e) {
                                e.preventDefault();
                                e.stopPropagation();
                                isHiding = !isHiding;
                                renderState();
                            });
                        }
                    });
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initZandersCrossSellingStockToggle);
                } else {
                    initZandersCrossSellingStockToggle();
                }

                // In case content loads dynamically or via Shopware page transition
                window.addEventListener('load', initZandersCrossSellingStockToggle);
                document.addEventListener('pageLoaded', initZandersCrossSellingStockToggle);
            })();
        </script>
    {% endif %}
{% endblock %}
