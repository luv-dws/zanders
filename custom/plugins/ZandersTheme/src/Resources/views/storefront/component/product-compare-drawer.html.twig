{# Zanders Product Comparison Drawer & Bottom Dock #}
{% block component_product_compare_drawer %}
    {% if context.customer is defined and context.customer and not context.customer.guest %}
        <!-- Product Comparison Backdrop -->
        {% block component_product_compare_drawer_backdrop %}
            <div class="zanders-compare-backdrop" data-compare-backdrop aria-hidden="true"></div>
        {% endblock %}

        <!-- Product Comparison Modal / Drawer -->
        {% block component_product_compare_drawer_modal %}
            <div
                class="zanders-compare-modal"
                id="zandersCompareModal"
                data-compare-drawer="true"
                role="dialog"
                aria-modal="true"
                aria-labelledby="zandersCompareModalTitle"
                aria-hidden="true"
            >
                {% block component_product_compare_drawer_modal_header %}
                    <div class="zanders-compare-modal-header">
                        <div class="zanders-compare-title-wrap">
                            <h2 id="zandersCompareModalTitle" class="zanders-compare-title">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                    <path d="M9 9h6M9 12h6M9 15h4"></path>
                                </svg>
                                {{ 'zanders.compare.title'|trans|default('Product Comparison') }}
                            </h2>
                            <span class="zanders-compare-badge-pill" data-compare-status-text>
                                {{ 'zanders.compare.statusText'|trans|default('0 of 5 products') }}
                            </span>
                        </div>

                        <div class="zanders-compare-header-actions">
                            <button type="button"
                                    class="zanders-compare-clear-btn"
                                    data-compare-clear-btn
                                    title="{{ 'zanders.compare.clearAllTitle'|trans|default('Clear all products from comparison')|striptags }}">
                                {{ 'zanders.compare.clearAll'|trans|default('Clear All') }}
                            </button>
                            <button type="button"
                                    class="zanders-compare-close-btn"
                                    data-compare-close-btn
                                    title="{{ 'zanders.compare.closeComparison'|trans|default('Close comparison')|striptags }}"
                                    aria-label="{{ 'zanders.compare.closeComparison'|trans|default('Close comparison')|striptags }}">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </div>
                    </div>
                {% endblock %}

                {% block component_product_compare_drawer_modal_body %}
                    <div class="zanders-compare-modal-body">
                        <!-- Empty State Container -->
                        {% block component_product_compare_drawer_empty_state %}
                            <div class="zanders-compare-empty" data-compare-empty>
                                <div class="zanders-compare-empty-icon" aria-hidden="true">
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                        <path d="M9 9h6M9 12h6M9 15h4"></path>
                                    </svg>
                                </div>
                                <h3>{{ 'zanders.compare.emptyTitle'|trans|default('No products selected to compare') }}</h3>
                                <p>{{ 'zanders.compare.emptyDescription'|trans|default('Browse our catalog and click the compare icon on products to see their specifications, stock availability, and prices side by side.') }}</p>
                                <button type="button" class="zanders-compare-browse-btn" data-compare-close-btn>
                                    {{ 'zanders.compare.continueBrowsing'|trans|default('Continue Browsing') }}
                                </button>
                            </div>
                        {% endblock %}

                        <!-- Populated State Table Container -->
                        {% block component_product_compare_drawer_content_table %}
                            <div class="zanders-compare-table-wrapper is-hidden" data-compare-content>
                                <!-- Injected dynamically by JavaScript -->
                            </div>
                        {% endblock %}
                    </div>
                {% endblock %}

                {% block component_product_compare_drawer_modal_footer %}
                    <div class="zanders-compare-modal-footer">
                        <span>{{ 'zanders.compare.footerHint'|trans|default('Compare up to 5 items side by side to evaluate features and availability.') }}</span>
                        <div class="zanders-compare-footer-actions">
                            <button type="button" class="btn-clear-compare" data-compare-clear-btn>
                                {{ 'zanders.compare.clearAll'|trans|default('Clear All') }}
                            </button>
                            <button type="button" class="btn-close-compare" data-compare-close-btn>
                                {{ 'zanders.compare.close'|trans|default('Close') }}
                            </button>
                        </div>
                    </div>
                {% endblock %}
            </div>
        {% endblock %}

        <!-- Floating Toast Notification -->
        {% block component_product_compare_drawer_toast %}
            <div class="zanders-compare-toast" data-compare-toast role="status" aria-live="polite">
                <div class="zanders-toast-icon-wrap" data-compare-toast-icon aria-hidden="true">
                    <svg class="zanders-toast-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" fill="#10B981"></circle>
                        <path d="M8 12.5L10.5 15L16 9.5" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </div>
                <div class="zanders-toast-content">
                    <div class="zanders-toast-title" data-compare-toast-title>{{ 'zanders.compare.toastTitle'|trans|default('Added to Comparison') }}</div>
                    <div class="zanders-toast-message" data-compare-toast-msg></div>
                </div>
                <div class="zanders-toast-actions">
                    <button type="button" class="zanders-toast-action-btn" data-compare-open-btn>
                        <span>{{ 'zanders.compare.viewCompare'|trans|default('View Compare') }}</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                    <button type="button" class="zanders-toast-close" data-compare-toast-close aria-label="{{ 'zanders.compare.closeNotification'|trans|default('Close notification')|striptags }}" title="{{ 'zanders.compare.dismiss'|trans|default('Dismiss')|striptags }}">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>
        {% endblock %}
    {% endif %}
{% endblock %}
