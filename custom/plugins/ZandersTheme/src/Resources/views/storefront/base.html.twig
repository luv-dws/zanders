{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_head %}
    {{ parent() }}
    <script>
        (function() {
            try {
                if (localStorage.getItem('zanders_hide_prices') === 'true') {
                    document.documentElement.classList.add('prices-hidden', 'zanders-prices-hidden');
                }
                if (localStorage.getItem('zanders_age_verified') === 'true' || document.cookie.indexOf('zanders_age_verified=true') !== -1) {
                    document.documentElement.classList.add('zanders-age-verified');
                }
            } catch (e) {}
        })();
    </script>
{% endblock %}

{% block base_body_inner %}
    <aside class="zanders-floating-finders" aria-label="Quick Finders">
        <a href="#firearms-finder" class="zanders-floating-tab zanders-tab-firearms" title="Firearms Finder">
            <span class="zanders-tab-icon">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="22" y1="12" x2="18" y2="12"></line><line x1="6" y1="12" x2="2" y2="12"></line><line x1="12" y1="6" x2="12" y2="2"></line><line x1="12" y1="22" x2="12" y2="18"></line></svg>
            </span>
            <span class="zanders-tab-text">Firearms Finder</span>
        </a>
        <a href="#ammo-finder" class="zanders-floating-tab zanders-tab-ammo" title="Ammo Finder">
            <span class="zanders-tab-icon">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="8" y1="10" x2="16" y2="10"></line><line x1="8" y1="14" x2="12" y2="14"></line></svg>
            </span>
            <span class="zanders-tab-text">Ammo Finder</span>
        </a>
    </aside>

    {{ parent() }}

    {% sw_include '@Storefront/storefront/component/age-verification-modal.html.twig' %}
{% endblock %}

