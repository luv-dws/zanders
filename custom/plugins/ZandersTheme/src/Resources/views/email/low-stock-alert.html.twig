<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ subject|default('Low Stock Alert') }}</title>
</head>
<body style="margin: 0; padding: 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f4f6f8; color: #333333;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 680px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); border: 1px solid #e1e4e8;">
        <!-- Header Banner -->
        <tr>
            <td style="background: linear-gradient(135deg, #d32f2f, #b71c1c); padding: 24px 32px; color: #ffffff;">
                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                    <tr>
                        <td>
                            <h1 style="margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.5px; color: #ffffff;">
                                &#9888; Low Stock Inventory Alert
                            </h1>
                            <p style="margin: 6px 0 0 0; font-size: 14px; color: #ffebee; opacity: 0.95;">
                                Store: <strong>{{ shopName }}</strong> &bull; {{ date|default("now"|date("Y-m-d H:i:s")) }}
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <!-- Main Body -->
        <tr>
            <td style="padding: 32px;">
                <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.6; color: #2d3748;">
                    Hello Administrator,
                </p>
                <p style="margin: 0 0 24px 0; font-size: 14px; line-height: 1.6; color: #4a5568;">
                    This is an automated notification to inform you that <strong>{{ productCount }}</strong> product(s) have dropped to or below the configured low stock threshold of <strong>{{ threshold }}</strong> units.
                </p>

                {% if order is defined and order is not null %}
                <!-- Order Trigger Context Box -->
                <div style="margin: 0 0 24px 0; padding: 14px 18px; background-color: #ebf8ff; border-left: 4px solid #3182ce; border-radius: 4px;">
                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="font-size: 13px; color: #2b6cb0;">
                        <tr>
                            <td>
                                <strong>Triggered by Order:</strong> #{{ order.orderNumber|default('N/A') }}
                                {% if order.orderDateTime is defined and order.orderDateTime is not null %}
                                    &bull; <strong>Placed on:</strong> {{ order.orderDateTime|date('Y-m-d H:i:s') }}
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </div>
                {% endif %}

                <!-- Products Table -->
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse; margin-bottom: 24px; font-size: 13px;">
                    <thead>
                        <tr style="background-color: #f7fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                            <th style="padding: 12px 14px; font-weight: 600; color: #4a5568;">Product Name</th>
                            <th style="padding: 12px 14px; font-weight: 600; color: #4a5568;">SKU / Number</th>
                            <th style="padding: 12px 14px; font-weight: 600; color: #4a5568; text-align: center;">Available Stock</th>
                            <th style="padding: 12px 14px; font-weight: 600; color: #4a5568; text-align: center;">Physical Stock</th>
                            <th style="padding: 12px 14px; font-weight: 600; color: #4a5568; text-align: center;">Threshold</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in lowStockProducts %}
                        <tr style="border-bottom: 1px solid #edf2f7; {% if loop.index is even %}background-color: #fafbfc;{% endif %}">
                            <td style="padding: 12px 14px; font-weight: 500; color: #1a202c;">
                                {{ item.name }}
                            </td>
                            <td style="padding: 12px 14px; font-family: monospace, SFMono-Regular, Consolas; color: #4a5568; font-size: 12px;">
                                {{ item.productNumber }}
                            </td>
                            <td style="padding: 12px 14px; text-align: center;">
                                <span style="display: inline-block; padding: 3px 8px; border-radius: 12px; font-weight: 700; font-size: 12px; {% if item.stock <= 0 %}background-color: #fed7d7; color: #9b2c2c;{% else %}background-color: #feebc8; color: #7b341e;{% endif %}">
                                    {{ item.stock }}
                                </span>
                            </td>
                            <td style="padding: 12px 14px; text-align: center; color: #718096; font-size: 12px;">
                                {{ item.physicalStock|default(item.stock) }}
                            </td>
                            <td style="padding: 12px 14px; text-align: center; color: #a0aec0; font-size: 12px;">
                                {{ threshold }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <p style="margin: 0 0 16px 0; font-size: 14px; line-height: 1.6; color: #4a5568;">
                    Please review your inventory levels and restock items as necessary to prevent fulfillment delays or out-of-stock items.
                </p>

                <!-- Admin Action Button -->
                {% if adminUrl is defined and adminUrl is not empty %}
                <div style="margin: 24px 0 16px 0; text-align: left;">
                    <a href="{{ adminUrl }}" style="display: inline-block; background-color: #1a73e8; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 4px; font-weight: 600; font-size: 14px;">
                        Open Admin Inventory
                    </a>
                </div>
                {% endif %}
            </td>
        </tr>

        <!-- Footer -->
        <tr>
            <td style="background-color: #f7fafc; padding: 18px 32px; border-top: 1px solid #edf2f7; text-align: center; font-size: 12px; color: #a0aec0;">
                This email was automatically generated by the Zanders Low Stock Alert system for {{ shopName }}.
            </td>
        </tr>
    </table>
</body>
</html>
