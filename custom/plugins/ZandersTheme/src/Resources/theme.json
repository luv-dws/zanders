{
    "name": "ZandersTheme",
    "author": "ZANDERS",
    "views": [
        "@Storefront",
        "@Plugins",
        "@ZandersTheme"
    ],
    "style": [
        "app/storefront/src/scss/overrides.scss",
        "@Storefront",
        "app/storefront/src/scss/base.scss"
    ],
    "script": [
        "@Storefront",
        "app/storefront/dist/storefront/js/zanders-theme/zanders-theme.js"
    ],
    "asset": [
        "@Storefront",
        "app/storefront/src/assets"
    ],
    "config": {
        "fields": {
            "sw-color-brand-primary": {
                "type": "color",
                "value": "#991020",
                "editable": true,
                "block": "themeColors",
                "order": 100
            },
            "sw-color-brand-secondary": {
                "type": "color",
                "value": "#343434",
                "editable": true,
                "block": "themeColors",
                "order": 200
            }
        },
        "blocks": {
            "themeColors": []
        }
    }
}
